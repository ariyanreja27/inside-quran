{
  "surahNumber": 100,
  "surahName": "Al-Adiyat",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡعَـٰدِیَـٰتِ ضَبۡحࣰا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 2,
      "text": "فَٱلۡمُورِیَـٰتِ قَدۡحࣰا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 3,
      "text": "فَٱلۡمُغِیرَ ٰ⁠تِ صُبۡحࣰا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 4,
      "text": "فَأَثَرۡنَ بِهِۦ نَقۡعࣰا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 5,
      "text": "فَوَسَطۡنَ بِهِۦ جَمۡعًا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 6,
      "text": "إِنَّ ٱلۡإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودࣱ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 7,
      "text": "وَإِنَّهُۥ عَلَىٰ ذَ ٰ⁠لِكَ لَشَهِیدࣱ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 8,
      "text": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَیۡرِ لَشَدِیدٌ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 542
    },
    {
      "numberInSurah": 9,
      "text": "۞ أَفَلَا یَعۡلَمُ إِذَا بُعۡثِرَ مَا فِی ٱلۡقُبُورِ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 240,
      "ruku": 542
    },
    {
      "numberInSurah": 10,
      "text": "وَحُصِّلَ مَا فِی ٱلصُّدُورِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 542
    },
    {
      "numberInSurah": 11,
      "text": "إِنَّ رَبَّهُم بِهِمۡ یَوۡمَىِٕذࣲ لَّخَبِیرُۢ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 542
    }
  ]
}