{
  "surahNumber": 53,
  "surahName": "An-Najm",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلنَّجۡمِ إِذَا هَوَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 2,
      "text": "مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 3,
      "text": "وَمَا یَنطِقُ عَنِ ٱلۡهَوَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 4,
      "text": "إِنۡ هُوَ إِلَّا وَحۡیࣱ یُوحَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 5,
      "text": "عَلَّمَهُۥ شَدِیدُ ٱلۡقُوَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 6,
      "text": "ذُو مِرَّةࣲ فَٱسۡتَوَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 7,
      "text": "وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 8,
      "text": "ثُمَّ دَنَا فَتَدَلَّىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 9,
      "text": "فَكَانَ قَابَ قَوۡسَیۡنِ أَوۡ أَدۡنَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 10,
      "text": "فَأَوۡحَىٰۤ إِلَىٰ عَبۡدِهِۦ مَاۤ أَوۡحَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 11,
      "text": "مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 12,
      "text": "أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا یَرَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 13,
      "text": "وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 14,
      "text": "عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 15,
      "text": "عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 16,
      "text": "إِذۡ یَغۡشَى ٱلسِّدۡرَةَ مَا یَغۡشَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 17,
      "text": "مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 18,
      "text": "لَقَدۡ رَأَىٰ مِنۡ ءَایَـٰتِ رَبِّهِ ٱلۡكُبۡرَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 19,
      "text": "أَفَرَءَیۡتُمُ ٱللَّـٰتَ وَٱلۡعُزَّىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 20,
      "text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 21,
      "text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 22,
      "text": "تِلۡكَ إِذࣰا قِسۡمَةࣱ ضِیزَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 23,
      "text": "إِنۡ هِیَ إِلَّاۤ أَسۡمَاۤءࣱ سَمَّیۡتُمُوهَاۤ أَنتُمۡ وَءَابَاۤؤُكُم مَّاۤ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَـٰنٍۚ إِن یَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَاۤءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 24,
      "text": "أَمۡ لِلۡإِنسَـٰنِ مَا تَمَنَّىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 25,
      "text": "فَلِلَّهِ ٱلۡـَٔاخِرَةُ وَٱلۡأُولَىٰ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 210,
      "ruku": 460
    },
    {
      "numberInSurah": 26,
      "text": "۞ وَكَم مِّن مَّلَكࣲ فِی ٱلسَّمَـٰوَ ٰ⁠تِ لَا تُغۡنِی شَفَـٰعَتُهُمۡ شَیۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن یَأۡذَنَ ٱللَّهُ لِمَن یَشَاۤءُ وَیَرۡضَىٰۤ\n",
      "juz": 27,
      "page": 526,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 27,
      "text": "إِنَّ ٱلَّذِینَ لَا یُؤۡمِنُونَ بِٱلۡـَٔاخِرَةِ لَیُسَمُّونَ ٱلۡمَلَـٰۤىِٕكَةَ تَسۡمِیَةَ ٱلۡأُنثَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 28,
      "text": "وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن یَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا یُغۡنِی مِنَ ٱلۡحَقِّ شَیۡـࣰٔا\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 29,
      "text": "فَأَعۡرِضۡ عَن مَّن تَوَلَّىٰ عَن ذِكۡرِنَا وَلَمۡ یُرِدۡ إِلَّا ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 30,
      "text": "ذَ ٰ⁠لِكَ مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِیلِهِۦ وَهُوَ أَعۡلَمُ بِمَنِ ٱهۡتَدَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 31,
      "text": "وَلِلَّهِ مَا فِی ٱلسَّمَـٰوَ ٰ⁠تِ وَمَا فِی ٱلۡأَرۡضِ لِیَجۡزِیَ ٱلَّذِینَ أَسَـٰۤـُٔوا۟ بِمَا عَمِلُوا۟ وَیَجۡزِیَ ٱلَّذِینَ أَحۡسَنُوا۟ بِٱلۡحُسۡنَى\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 32,
      "text": "ٱلَّذِینَ یَجۡتَنِبُونَ كَبَـٰۤىِٕرَ ٱلۡإِثۡمِ وَٱلۡفَوَ ٰ⁠حِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَ ٰ⁠سِعُ ٱلۡمَغۡفِرَةِۚ هُوَ أَعۡلَمُ بِكُمۡ إِذۡ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَإِذۡ أَنتُمۡ أَجِنَّةࣱ فِی بُطُونِ أُمَّهَـٰتِكُمۡۖ فَلَا تُزَكُّوۤا۟ أَنفُسَكُمۡۖ هُوَ أَعۡلَمُ بِمَنِ ٱتَّقَىٰۤ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 461
    },
    {
      "numberInSurah": 33,
      "text": "أَفَرَءَیۡتَ ٱلَّذِی تَوَلَّىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 34,
      "text": "وَأَعۡطَىٰ قَلِیلࣰا وَأَكۡدَىٰۤ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 35,
      "text": "أَعِندَهُۥ عِلۡمُ ٱلۡغَیۡبِ فَهُوَ یَرَىٰۤ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 36,
      "text": "أَمۡ لَمۡ یُنَبَّأۡ بِمَا فِی صُحُفِ مُوسَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 37,
      "text": "وَإِبۡرَ ٰ⁠هِیمَ ٱلَّذِی وَفَّىٰۤ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 38,
      "text": "أَلَّا تَزِرُ وَازِرَةࣱ وِزۡرَ أُخۡرَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 39,
      "text": "وَأَن لَّیۡسَ لِلۡإِنسَـٰنِ إِلَّا مَا سَعَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 40,
      "text": "وَأَنَّ سَعۡیَهُۥ سَوۡفَ یُرَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 41,
      "text": "ثُمَّ یُجۡزَىٰهُ ٱلۡجَزَاۤءَ ٱلۡأَوۡفَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 42,
      "text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلۡمُنتَهَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 43,
      "text": "وَأَنَّهُۥ هُوَ أَضۡحَكَ وَأَبۡكَىٰ\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 44,
      "text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحۡیَا\n",
      "juz": 27,
      "page": 527,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 45,
      "text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَیۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 46,
      "text": "مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 47,
      "text": "وَأَنَّ عَلَیۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 48,
      "text": "وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 49,
      "text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 50,
      "text": "وَأَنَّهُۥۤ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 51,
      "text": "وَثَمُودَا۟ فَمَاۤ أَبۡقَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 52,
      "text": "وَقَوۡمَ نُوحࣲ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُوا۟ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 53,
      "text": "وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 54,
      "text": "فَغَشَّىٰهَا مَا غَشَّىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 55,
      "text": "فَبِأَیِّ ءَالَاۤءِ رَبِّكَ تَتَمَارَىٰ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 56,
      "text": "هَـٰذَا نَذِیرࣱ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰۤ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 57,
      "text": "أَزِفَتِ ٱلۡـَٔازِفَةُ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 58,
      "text": "لَیۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 59,
      "text": "أَفَمِنۡ هَـٰذَا ٱلۡحَدِیثِ تَعۡجَبُونَ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 60,
      "text": "وَتَضۡحَكُونَ وَلَا تَبۡكُونَ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 61,
      "text": "وَأَنتُمۡ سَـٰمِدُونَ\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    },
    {
      "numberInSurah": 62,
      "text": "فَٱسۡجُدُوا۟ لِلَّهِ وَٱعۡبُدُوا۟ ۩\n",
      "juz": 27,
      "page": 528,
      "hizbQuarter": 211,
      "ruku": 462
    }
  ]
}