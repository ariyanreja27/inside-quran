  "surahNumber": 113,
  "surahName": "Al-Falaq",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 555
    },
    {
      "numberInSurah": 2,
      "text": "مِن شَرِّ مَا خَلَقَ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 555
    },
    {
      "numberInSurah": 3,
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 555
    },
    {
      "numberInSurah": 4,
      "text": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِی ٱلۡعُقَدِ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 555
    },
    {
      "numberInSurah": 5,
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 555
    }
  ]
}