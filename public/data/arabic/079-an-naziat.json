{
  "surahNumber": 79,
  "surahName": "An-Nazi'at",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلنَّـٰزِعَـٰتِ غَرۡقࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلنَّـٰشِطَـٰتِ نَشۡطࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلسَّـٰبِحَـٰتِ سَبۡحࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 4,
      "text": "فَٱلسَّـٰبِقَـٰتِ سَبۡقࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 5,
      "text": "فَٱلۡمُدَبِّرَ ٰ⁠تِ أَمۡرࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 6,
      "text": "یَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 7,
      "text": "تَتۡبَعُهَا ٱلرَّادِفَةُ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 8,
      "text": "قُلُوبࣱ یَوۡمَىِٕذࣲ وَاجِفَةٌ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 9,
      "text": "أَبۡصَـٰرُهَا خَـٰشِعَةࣱ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 10,
      "text": "یَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِی ٱلۡحَافِرَةِ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 11,
      "text": "أَءِذَا كُنَّا عِظَـٰمࣰا نَّخِرَةࣰ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 12,
      "text": "قَالُوا۟ تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 13,
      "text": "فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 14,
      "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 15,
      "text": "هَلۡ أَتَىٰكَ حَدِیثُ مُوسَىٰۤ\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 16,
      "text": "إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 17,
      "text": "ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 18,
      "text": "فَقُلۡ هَل لَّكَ إِلَىٰۤ أَن تَزَكَّىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 19,
      "text": "وَأَهۡدِیَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 20,
      "text": "فَأَرَىٰهُ ٱلۡـَٔایَةَ ٱلۡكُبۡرَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 21,
      "text": "فَكَذَّبَ وَعَصَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 22,
      "text": "ثُمَّ أَدۡبَرَ یَسۡعَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 23,
      "text": "فَحَشَرَ فَنَادَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 24,
      "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 25,
      "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡـَٔاخِرَةِ وَٱلۡأُولَىٰۤ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 26,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَعِبۡرَةࣰ لِّمَن یَخۡشَىٰۤ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 520
    },
    {
      "numberInSurah": 27,
      "text": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَاۤءُۚ بَنَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 28,
      "text": "رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 29,
      "text": "وَأَغۡطَشَ لَیۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 30,
      "text": "وَٱلۡأَرۡضَ بَعۡدَ ذَ ٰ⁠لِكَ دَحَىٰهَاۤ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 31,
      "text": "أَخۡرَجَ مِنۡهَا مَاۤءَهَا وَمَرۡعَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 32,
      "text": "وَٱلۡجِبَالَ أَرۡسَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 33,
      "text": "مَتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 34,
      "text": "فَإِذَا جَاۤءَتِ ٱلطَّاۤمَّةُ ٱلۡكُبۡرَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 35,
      "text": "یَوۡمَ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ مَا سَعَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 36,
      "text": "وَبُرِّزَتِ ٱلۡجَحِیمُ لِمَن یَرَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 37,
      "text": "فَأَمَّا مَن طَغَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 38,
      "text": "وَءَاثَرَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 39,
      "text": "فَإِنَّ ٱلۡجَحِیمَ هِیَ ٱلۡمَأۡوَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 40,
      "text": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 41,
      "text": "فَإِنَّ ٱلۡجَنَّةَ هِیَ ٱلۡمَأۡوَىٰ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 42,
      "text": "یَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَیَّانَ مُرۡسَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 43,
      "text": "فِیمَ أَنتَ مِن ذِكۡرَىٰهَاۤ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 44,
      "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَاۤ\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 45,
      "text": "إِنَّمَاۤ أَنتَ مُنذِرُ مَن یَخۡشَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    },
    {
      "numberInSurah": 46,
      "text": "كَأَنَّهُمۡ یَوۡمَ یَرَوۡنَهَا لَمۡ یَلۡبَثُوۤا۟ إِلَّا عَشِیَّةً أَوۡ ضُحَىٰهَا\n",
      "juz": 30,
      "page": 584,
      "hizbQuarter": 233,
      "ruku": 521
    }
  ]
}