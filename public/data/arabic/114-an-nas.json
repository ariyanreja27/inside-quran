      "page": 604,
      "hizbQuarter": 240,
      "ruku": 556
    },
    {
      "numberInSurah": 5,
      "text": "ٱلَّذِی یُوَسۡوِسُ فِی صُدُورِ ٱلنَّاسِ\n",
