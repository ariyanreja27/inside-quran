    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 556
    },
    {
      "numberInSurah": 2,
      "text": "مَلِكِ ٱلنَّاسِ\n",
      "juz": 30,
      "page": 604,
      "hizbQuarter": 240,
      "ruku": 556
    },
    {
