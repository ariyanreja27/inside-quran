{
  "surahNumber": 90,
  "surahName": "Al-Balad",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ لَاۤ أُقۡسِمُ بِهَـٰذَا ٱلۡبَلَدِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 2,
      "text": "وَأَنتَ حِلُّۢ بِهَـٰذَا ٱلۡبَلَدِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 3,
      "text": "وَوَالِدࣲ وَمَا وَلَدَ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 4,
      "text": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِی كَبَدٍ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 5,
      "text": "أَیَحۡسَبُ أَن لَّن یَقۡدِرَ عَلَیۡهِ أَحَدࣱ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 6,
      "text": "یَقُولُ أَهۡلَكۡتُ مَالࣰا لُّبَدًا\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 7,
      "text": "أَیَحۡسَبُ أَن لَّمۡ یَرَهُۥۤ أَحَدٌ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 8,
      "text": "أَلَمۡ نَجۡعَل لَّهُۥ عَیۡنَیۡنِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 9,
      "text": "وَلِسَانࣰا وَشَفَتَیۡنِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 10,
      "text": "وَهَدَیۡنَـٰهُ ٱلنَّجۡدَیۡنِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 11,
      "text": "فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 12,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 13,
      "text": "فَكُّ رَقَبَةٍ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 14,
      "text": "أَوۡ إِطۡعَـٰمࣱ فِی یَوۡمࣲ ذِی مَسۡغَبَةࣲ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 15,
      "text": "یَتِیمࣰا ذَا مَقۡرَبَةٍ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 16,
      "text": "أَوۡ مِسۡكِینࣰا ذَا مَتۡرَبَةࣲ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 17,
      "text": "ثُمَّ كَانَ مِنَ ٱلَّذِینَ ءَامَنُوا۟ وَتَوَاصَوۡا۟ بِٱلصَّبۡرِ وَتَوَاصَوۡا۟ بِٱلۡمَرۡحَمَةِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 18,
      "text": "أُو۟لَـٰۤىِٕكَ أَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 19,
      "text": "وَٱلَّذِینَ كَفَرُوا۟ بِـَٔایَـٰتِنَا هُمۡ أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    },
    {
      "numberInSurah": 20,
      "text": "عَلَیۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 238,
      "ruku": 532
    }
  ]
}