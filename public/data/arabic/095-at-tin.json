{
  "surahNumber": 95,
  "surahName": "At-Tin",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِّسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلتِّینِ وَٱلزَّیۡتُونِ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 2,
      "text": "وَطُورِ سِینِینَ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 3,
      "text": "وَهَـٰذَا ٱلۡبَلَدِ ٱلۡأَمِینِ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 4,
      "text": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَـٰنَ فِیۤ أَحۡسَنِ تَقۡوِیمࣲ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 5,
      "text": "ثُمَّ رَدَدۡنَـٰهُ أَسۡفَلَ سَـٰفِلِینَ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 6,
      "text": "إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونࣲ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 7,
      "text": "فَمَا یُكَذِّبُكَ بَعۡدُ بِٱلدِّینِ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    },
    {
      "numberInSurah": 8,
      "text": "أَلَیۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَـٰكِمِینَ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 537
    }
  ]
}