{
  "surahNumber": 78,
  "surahName": "An-Naba",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ عَمَّ یَتَسَاۤءَلُونَ\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 2,
      "text": "عَنِ ٱلنَّبَإِ ٱلۡعَظِیمِ\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 3,
      "text": "ٱلَّذِی هُمۡ فِیهِ مُخۡتَلِفُونَ\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 4,
      "text": "كَلَّا سَیَعۡلَمُونَ\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 5,
      "text": "ثُمَّ كَلَّا سَیَعۡلَمُونَ\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 6,
      "text": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَـٰدࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 7,
      "text": "وَٱلۡجِبَالَ أَوۡتَادࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 8,
      "text": "وَخَلَقۡنَـٰكُمۡ أَزۡوَ ٰ⁠جࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 9,
      "text": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 10,
      "text": "وَجَعَلۡنَا ٱلَّیۡلَ لِبَاسࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 11,
      "text": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 12,
      "text": "وَبَنَیۡنَا فَوۡقَكُمۡ سَبۡعࣰا شِدَادࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 13,
      "text": "وَجَعَلۡنَا سِرَاجࣰا وَهَّاجࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 14,
      "text": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَ ٰ⁠تِ مَاۤءࣰ ثَجَّاجࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 15,
      "text": "لِّنُخۡرِجَ بِهِۦ حَبࣰّا وَنَبَاتࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 16,
      "text": "وَجَنَّـٰتٍ أَلۡفَافًا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 17,
      "text": "إِنَّ یَوۡمَ ٱلۡفَصۡلِ كَانَ مِیقَـٰتࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 18,
      "text": "یَوۡمَ یُنفَخُ فِی ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 19,
      "text": "وَفُتِحَتِ ٱلسَّمَاۤءُ فَكَانَتۡ أَبۡوَ ٰ⁠بࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 20,
      "text": "وَسُیِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 21,
      "text": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 22,
      "text": "لِّلطَّـٰغِینَ مَـَٔابࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 23,
      "text": "لَّـٰبِثِینَ فِیهَاۤ أَحۡقَابࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 24,
      "text": "لَّا یَذُوقُونَ فِیهَا بَرۡدࣰا وَلَا شَرَابًا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 25,
      "text": "إِلَّا حَمِیمࣰا وَغَسَّاقࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 26,
      "text": "جَزَاۤءࣰ وِفَاقًا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 27,
      "text": "إِنَّهُمۡ كَانُوا۟ لَا یَرۡجُونَ حِسَابࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 28,
      "text": "وَكَذَّبُوا۟ بِـَٔایَـٰتِنَا كِذَّابࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 29,
      "text": "وَكُلَّ شَیۡءٍ أَحۡصَیۡنَـٰهُ كِتَـٰبࣰا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 30,
      "text": "فَذُوقُوا۟ فَلَن نَّزِیدَكُمۡ إِلَّا عَذَابًا\n",
      "juz": 30,
      "page": 582,
      "hizbQuarter": 233,
      "ruku": 518
    },
    {
      "numberInSurah": 31,
      "text": "إِنَّ لِلۡمُتَّقِینَ مَفَازًا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 32,
      "text": "حَدَاۤىِٕقَ وَأَعۡنَـٰبࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 33,
      "text": "وَكَوَاعِبَ أَتۡرَابࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 34,
      "text": "وَكَأۡسࣰا دِهَاقࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 35,
      "text": "لَّا یَسۡمَعُونَ فِیهَا لَغۡوࣰا وَلَا كِذَّ ٰ⁠بࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 36,
      "text": "جَزَاۤءࣰ مِّن رَّبِّكَ عَطَاۤءً حِسَابࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 37,
      "text": "رَّبِّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا ٱلرَّحۡمَـٰنِۖ لَا یَمۡلِكُونَ مِنۡهُ خِطَابࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 38,
      "text": "یَوۡمَ یَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰۤىِٕكَةُ صَفࣰّاۖ لَّا یَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَـٰنُ وَقَالَ صَوَابࣰا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 39,
      "text": "ذَ ٰ⁠لِكَ ٱلۡیَوۡمُ ٱلۡحَقُّۖ فَمَن شَاۤءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    },
    {
      "numberInSurah": 40,
      "text": "إِنَّاۤ أَنذَرۡنَـٰكُمۡ عَذَابࣰا قَرِیبࣰا یَوۡمَ یَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ یَدَاهُ وَیَقُولُ ٱلۡكَافِرُ یَـٰلَیۡتَنِی كُنتُ تُرَ ٰ⁠بَۢا\n",
      "juz": 30,
      "page": 583,
      "hizbQuarter": 233,
      "ruku": 519
    }
  ]
}