{
  "surahNumber": 104,
  "surahName": "Al-Humazah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَیۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 2,
      "text": "ٱلَّذِی جَمَعَ مَالࣰا وَعَدَّدَهُۥ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 3,
      "text": "یَحۡسَبُ أَنَّ مَالَهُۥۤ أَخۡلَدَهُۥ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 4,
      "text": "كَلَّاۖ لَیُنۢبَذَنَّ فِی ٱلۡحُطَمَةِ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 5,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 6,
      "text": "نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 7,
      "text": "ٱلَّتِی تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّهَا عَلَیۡهِم مُّؤۡصَدَةࣱ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    },
    {
      "numberInSurah": 9,
      "text": "فِی عَمَدࣲ مُّمَدَّدَةِۭ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 546
    }
  ]
}