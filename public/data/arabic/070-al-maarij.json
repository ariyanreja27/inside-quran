{
  "surahNumber": 70,
  "surahName": "Al-Ma'arij",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ سَأَلَ سَاۤىِٕلُۢ بِعَذَابࣲ وَاقِعࣲ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 2,
      "text": "لِّلۡكَـٰفِرِینَ لَیۡسَ لَهُۥ دَافِعࣱ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 3,
      "text": "مِّنَ ٱللَّهِ ذِی ٱلۡمَعَارِجِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 4,
      "text": "تَعۡرُجُ ٱلۡمَلَـٰۤىِٕكَةُ وَٱلرُّوحُ إِلَیۡهِ فِی یَوۡمࣲ كَانَ مِقۡدَارُهُۥ خَمۡسِینَ أَلۡفَ سَنَةࣲ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 5,
      "text": "فَٱصۡبِرۡ صَبۡرࣰا جَمِیلًا\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 6,
      "text": "إِنَّهُمۡ یَرَوۡنَهُۥ بَعِیدࣰا\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 7,
      "text": "وَنَرَىٰهُ قَرِیبࣰا\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 8,
      "text": "یَوۡمَ تَكُونُ ٱلسَّمَاۤءُ كَٱلۡمُهۡلِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 9,
      "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 10,
      "text": "وَلَا یَسۡـَٔلُ حَمِیمٌ حَمِیمࣰا\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 11,
      "text": "یُبَصَّرُونَهُمۡۚ یَوَدُّ ٱلۡمُجۡرِمُ لَوۡ یَفۡتَدِی مِنۡ عَذَابِ یَوۡمِىِٕذِۭ بِبَنِیهِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 12,
      "text": "وَصَـٰحِبَتِهِۦ وَأَخِیهِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 13,
      "text": "وَفَصِیلَتِهِ ٱلَّتِی تُـٔۡوِیهِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 14,
      "text": "وَمَن فِی ٱلۡأَرۡضِ جَمِیعࣰا ثُمَّ یُنجِیهِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 15,
      "text": "كَلَّاۤۖ إِنَّهَا لَظَىٰ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 16,
      "text": "نَزَّاعَةࣰ لِّلشَّوَىٰ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 17,
      "text": "تَدۡعُوا۟ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 18,
      "text": "وَجَمَعَ فَأَوۡعَىٰۤ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 227,
      "ruku": 502
    },
    {
      "numberInSurah": 19,
      "text": "۞ إِنَّ ٱلۡإِنسَـٰنَ خُلِقَ هَلُوعًا\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 20,
      "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعࣰا\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 21,
      "text": "وَإِذَا مَسَّهُ ٱلۡخَیۡرُ مَنُوعًا\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 22,
      "text": "إِلَّا ٱلۡمُصَلِّینَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 23,
      "text": "ٱلَّذِینَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَاۤىِٕمُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 24,
      "text": "وَٱلَّذِینَ فِیۤ أَمۡوَ ٰ⁠لِهِمۡ حَقࣱّ مَّعۡلُومࣱ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 25,
      "text": "لِّلسَّاۤىِٕلِ وَٱلۡمَحۡرُومِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 26,
      "text": "وَٱلَّذِینَ یُصَدِّقُونَ بِیَوۡمِ ٱلدِّینِ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 27,
      "text": "وَٱلَّذِینَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 28,
      "text": "إِنَّ عَذَابَ رَبِّهِمۡ غَیۡرُ مَأۡمُونࣲ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 29,
      "text": "وَٱلَّذِینَ هُمۡ لِفُرُوجِهِمۡ حَـٰفِظُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 30,
      "text": "إِلَّا عَلَىٰۤ أَزۡوَ ٰ⁠جِهِمۡ أَوۡ مَا مَلَكَتۡ أَیۡمَـٰنُهُمۡ فَإِنَّهُمۡ غَیۡرُ مَلُومِینَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 31,
      "text": "فَمَنِ ٱبۡتَغَىٰ وَرَاۤءَ ذَ ٰ⁠لِكَ فَأُو۟لَـٰۤىِٕكَ هُمُ ٱلۡعَادُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 32,
      "text": "وَٱلَّذِینَ هُمۡ لِأَمَـٰنَـٰتِهِمۡ وَعَهۡدِهِمۡ رَ ٰ⁠عُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 33,
      "text": "وَٱلَّذِینَ هُم بِشَهَـٰدَ ٰ⁠تِهِمۡ قَاۤىِٕمُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 34,
      "text": "وَٱلَّذِینَ هُمۡ عَلَىٰ صَلَاتِهِمۡ یُحَافِظُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 35,
      "text": "أُو۟لَـٰۤىِٕكَ فِی جَنَّـٰتࣲ مُّكۡرَمُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 502
    },
    {
      "numberInSurah": 36,
      "text": "فَمَالِ ٱلَّذِینَ كَفَرُوا۟ قِبَلَكَ مُهۡطِعِینَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 37,
      "text": "عَنِ ٱلۡیَمِینِ وَعَنِ ٱلشِّمَالِ عِزِینَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 38,
      "text": "أَیَطۡمَعُ كُلُّ ٱمۡرِئࣲ مِّنۡهُمۡ أَن یُدۡخَلَ جَنَّةَ نَعِیمࣲ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 39,
      "text": "كَلَّاۤۖ إِنَّا خَلَقۡنَـٰهُم مِّمَّا یَعۡلَمُونَ\n",
      "juz": 29,
      "page": 569,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 40,
      "text": "فَلَاۤ أُقۡسِمُ بِرَبِّ ٱلۡمَشَـٰرِقِ وَٱلۡمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ\n",
      "juz": 29,
      "page": 570,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 41,
      "text": "عَلَىٰۤ أَن نُّبَدِّلَ خَیۡرࣰا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِینَ\n",
      "juz": 29,
      "page": 570,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 42,
      "text": "فَذَرۡهُمۡ یَخُوضُوا۟ وَیَلۡعَبُوا۟ حَتَّىٰ یُلَـٰقُوا۟ یَوۡمَهُمُ ٱلَّذِی یُوعَدُونَ\n",
      "juz": 29,
      "page": 570,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 43,
      "text": "یَوۡمَ یَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعࣰا كَأَنَّهُمۡ إِلَىٰ نُصُبࣲ یُوفِضُونَ\n",
      "juz": 29,
      "page": 570,
      "hizbQuarter": 228,
      "ruku": 503
    },
    {
      "numberInSurah": 44,
      "text": "خَـٰشِعَةً أَبۡصَـٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةࣱۚ ذَ ٰ⁠لِكَ ٱلۡیَوۡمُ ٱلَّذِی كَانُوا۟ یُوعَدُونَ\n",
      "juz": 29,
      "page": 570,
      "hizbQuarter": 228,
      "ruku": 503
    }
  ]
}