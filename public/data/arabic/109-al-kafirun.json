  "surahName": "Al-Kafirun",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ قُلۡ یَـٰۤأَیُّهَا ٱلۡكَـٰفِرُونَ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    },
    {
      "numberInSurah": 2,
      "text": "لَاۤ أَعۡبُدُ مَا تَعۡبُدُونَ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    },
    {
      "numberInSurah": 3,
      "text": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    },
    {
      "numberInSurah": 4,
      "text": "وَلَاۤ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    },
    {
      "numberInSurah": 5,
      "text": "وَلَاۤ أَنتُمۡ عَـٰبِدُونَ مَاۤ أَعۡبُدُ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    },
    {
      "numberInSurah": 6,
      "text": "لَكُمۡ دِینُكُمۡ وَلِیَ دِینِ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 551
    }
  ]
