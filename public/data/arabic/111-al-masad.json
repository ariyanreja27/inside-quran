{
  "surahNumber": 111,
  "surahName": "Al-Masad",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ تَبَّتۡ یَدَاۤ أَبِی لَهَبࣲ وَتَبَّ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 553
    },
    {
      "numberInSurah": 2,
      "text": "مَاۤ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 553
    },
    {
      "numberInSurah": 3,
      "text": "سَیَصۡلَىٰ نَارࣰا ذَاتَ لَهَبࣲ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 553
    },
    {
      "numberInSurah": 4,
      "text": "وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 553
    },
    {
      "numberInSurah": 5,
      "text": "فِی جِیدِهَا حَبۡلࣱ مِّن مَّسَدِۭ\n",
      "juz": 30,
      "page": 603,
      "hizbQuarter": 240,
      "ruku": 553
    }
  ]
}