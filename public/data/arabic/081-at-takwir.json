{
  "surahNumber": 81,
  "surahName": "At-Takwir",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلشَّمۡسُ كُوِّرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 2,
      "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 3,
      "text": "وَإِذَا ٱلۡجِبَالُ سُیِّرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 4,
      "text": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 5,
      "text": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 6,
      "text": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 7,
      "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 8,
      "text": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُىِٕلَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 9,
      "text": "بِأَیِّ ذَنۢبࣲ قُتِلَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 10,
      "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 11,
      "text": "وَإِذَا ٱلسَّمَاۤءُ كُشِطَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 12,
      "text": "وَإِذَا ٱلۡجَحِیمُ سُعِّرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 13,
      "text": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 14,
      "text": "عَلِمَتۡ نَفۡسࣱ مَّاۤ أَحۡضَرَتۡ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 15,
      "text": "فَلَاۤ أُقۡسِمُ بِٱلۡخُنَّسِ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 16,
      "text": "ٱلۡجَوَارِ ٱلۡكُنَّسِ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 17,
      "text": "وَٱلَّیۡلِ إِذَا عَسۡعَسَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 18,
      "text": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 19,
      "text": "إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِیمࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 20,
      "text": "ذِی قُوَّةٍ عِندَ ذِی ٱلۡعَرۡشِ مَكِینࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 21,
      "text": "مُّطَاعࣲ ثَمَّ أَمِینࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 22,
      "text": "وَمَا صَاحِبُكُم بِمَجۡنُونࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 23,
      "text": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِینِ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 24,
      "text": "وَمَا هُوَ عَلَى ٱلۡغَیۡبِ بِضَنِینࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 25,
      "text": "وَمَا هُوَ بِقَوۡلِ شَیۡطَـٰنࣲ رَّجِیمࣲ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 26,
      "text": "فَأَیۡنَ تَذۡهَبُونَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 27,
      "text": "إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَـٰلَمِینَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 28,
      "text": "لِمَن شَاۤءَ مِنكُمۡ أَن یَسۡتَقِیمَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    },
    {
      "numberInSurah": 29,
      "text": "وَمَا تَشَاۤءُونَ إِلَّاۤ أَن یَشَاۤءَ ٱللَّهُ رَبُّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 30,
      "page": 586,
      "hizbQuarter": 234,
      "ruku": 523
    }
  ]
}