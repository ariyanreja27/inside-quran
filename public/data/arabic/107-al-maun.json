{
  "surahNumber": 107,
  "surahName": "Al-Ma'un",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَرَءَیۡتَ ٱلَّذِی یُكَذِّبُ بِٱلدِّینِ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 2,
      "text": "فَذَ ٰ⁠لِكَ ٱلَّذِی یَدُعُّ ٱلۡیَتِیمَ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 3,
      "text": "وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 4,
      "text": "فَوَیۡلࣱ لِّلۡمُصَلِّینَ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 5,
      "text": "ٱلَّذِینَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 6,
      "text": "ٱلَّذِینَ هُمۡ یُرَاۤءُونَ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    },
    {
      "numberInSurah": 7,
      "text": "وَیَمۡنَعُونَ ٱلۡمَاعُونَ\n",
      "juz": 30,
      "page": 602,
      "hizbQuarter": 240,
      "ruku": 549
    }
  ]
}