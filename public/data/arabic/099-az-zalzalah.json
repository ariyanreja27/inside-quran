{
  "surahNumber": 99,
  "surahName": "Az-Zalzalah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 2,
      "text": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 3,
      "text": "وَقَالَ ٱلۡإِنسَـٰنُ مَا لَهَا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 4,
      "text": "یَوۡمَىِٕذࣲ تُحَدِّثُ أَخۡبَارَهَا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 5,
      "text": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 6,
      "text": "یَوۡمَىِٕذࣲ یَصۡدُرُ ٱلنَّاسُ أَشۡتَاتࣰا لِّیُرَوۡا۟ أَعۡمَـٰلَهُمۡ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 7,
      "text": "فَمَن یَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَیۡرࣰا یَرَهُۥ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    },
    {
      "numberInSurah": 8,
      "text": "وَمَن یَعۡمَلۡ مِثۡقَالَ ذَرَّةࣲ شَرࣰّا یَرَهُۥ\n",
      "juz": 30,
      "page": 599,
      "hizbQuarter": 239,
      "ruku": 541
    }
  ]
}