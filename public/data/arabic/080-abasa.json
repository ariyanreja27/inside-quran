{
  "surahNumber": 80,
  "surahName": "Abasa",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ عَبَسَ وَتَوَلَّىٰۤ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 2,
      "text": "أَن جَاۤءَهُ ٱلۡأَعۡمَىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 3,
      "text": "وَمَا یُدۡرِیكَ لَعَلَّهُۥ یَزَّكَّىٰۤ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 4,
      "text": "أَوۡ یَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰۤ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 5,
      "text": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 6,
      "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 7,
      "text": "وَمَا عَلَیۡكَ أَلَّا یَزَّكَّىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 8,
      "text": "وَأَمَّا مَن جَاۤءَكَ یَسۡعَىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 9,
      "text": "وَهُوَ یَخۡشَىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 10,
      "text": "فَأَنتَ عَنۡهُ تَلَهَّىٰ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 11,
      "text": "كَلَّاۤ إِنَّهَا تَذۡكِرَةࣱ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 12,
      "text": "فَمَن شَاۤءَ ذَكَرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 13,
      "text": "فِی صُحُفࣲ مُّكَرَّمَةࣲ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 14,
      "text": "مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 15,
      "text": "بِأَیۡدِی سَفَرَةࣲ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 16,
      "text": "كِرَامِۭ بَرَرَةࣲ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 17,
      "text": "قُتِلَ ٱلۡإِنسَـٰنُ مَاۤ أَكۡفَرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 18,
      "text": "مِنۡ أَیِّ شَیۡءٍ خَلَقَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 19,
      "text": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 20,
      "text": "ثُمَّ ٱلسَّبِیلَ یَسَّرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 21,
      "text": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 22,
      "text": "ثُمَّ إِذَا شَاۤءَ أَنشَرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 23,
      "text": "كَلَّا لَمَّا یَقۡضِ مَاۤ أَمَرَهُۥ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 24,
      "text": "فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ إِلَىٰ طَعَامِهِۦۤ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 25,
      "text": "أَنَّا صَبَبۡنَا ٱلۡمَاۤءَ صَبࣰّا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 26,
      "text": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 27,
      "text": "فَأَنۢبَتۡنَا فِیهَا حَبࣰّا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 28,
      "text": "وَعِنَبࣰا وَقَضۡبࣰا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 29,
      "text": "وَزَیۡتُونࣰا وَنَخۡلࣰا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 30,
      "text": "وَحَدَاۤىِٕقَ غُلۡبࣰا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 31,
      "text": "وَفَـٰكِهَةࣰ وَأَبࣰّا\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 32,
      "text": "مَّتَـٰعࣰا لَّكُمۡ وَلِأَنۡعَـٰمِكُمۡ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 33,
      "text": "فَإِذَا جَاۤءَتِ ٱلصَّاۤخَّةُ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 34,
      "text": "یَوۡمَ یَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِیهِ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 35,
      "text": "وَأُمِّهِۦ وَأَبِیهِ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 36,
      "text": "وَصَـٰحِبَتِهِۦ وَبَنِیهِ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 37,
      "text": "لِكُلِّ ٱمۡرِئࣲ مِّنۡهُمۡ یَوۡمَىِٕذࣲ شَأۡنࣱ یُغۡنِیهِ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 38,
      "text": "وُجُوهࣱ یَوۡمَىِٕذࣲ مُّسۡفِرَةࣱ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 39,
      "text": "ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 40,
      "text": "وَوُجُوهࣱ یَوۡمَىِٕذٍ عَلَیۡهَا غَبَرَةࣱ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 41,
      "text": "تَرۡهَقُهَا قَتَرَةٌ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    },
    {
      "numberInSurah": 42,
      "text": "أُو۟لَـٰۤىِٕكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ\n",
      "juz": 30,
      "page": 585,
      "hizbQuarter": 234,
      "ruku": 522
    }
  ]
}