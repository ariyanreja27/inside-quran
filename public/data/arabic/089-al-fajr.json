{
  "surahNumber": 89,
  "surahName": "Al-Fajr",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡفَجۡرِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 2,
      "text": "وَلَیَالٍ عَشۡرࣲ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلَّیۡلِ إِذَا یَسۡرِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 5,
      "text": "هَلۡ فِی ذَ ٰ⁠لِكَ قَسَمࣱ لِّذِی حِجۡرٍ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 6,
      "text": "أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِعَادٍ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 7,
      "text": "إِرَمَ ذَاتِ ٱلۡعِمَادِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 8,
      "text": "ٱلَّتِی لَمۡ یُخۡلَقۡ مِثۡلُهَا فِی ٱلۡبِلَـٰدِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 9,
      "text": "وَثَمُودَ ٱلَّذِینَ جَابُوا۟ ٱلصَّخۡرَ بِٱلۡوَادِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 10,
      "text": "وَفِرۡعَوۡنَ ذِی ٱلۡأَوۡتَادِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 11,
      "text": "ٱلَّذِینَ طَغَوۡا۟ فِی ٱلۡبِلَـٰدِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 12,
      "text": "فَأَكۡثَرُوا۟ فِیهَا ٱلۡفَسَادَ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 13,
      "text": "فَصَبَّ عَلَیۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 14,
      "text": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 15,
      "text": "فَأَمَّا ٱلۡإِنسَـٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَیَقُولُ رَبِّیۤ أَكۡرَمَنِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 16,
      "text": "وَأَمَّاۤ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَیۡهِ رِزۡقَهُۥ فَیَقُولُ رَبِّیۤ أَهَـٰنَنِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 17,
      "text": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡیَتِیمَ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 18,
      "text": "وَلَا تَحَـٰۤضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 19,
      "text": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 20,
      "text": "وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 21,
      "text": "كَلَّاۤۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 22,
      "text": "وَجَاۤءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 23,
      "text": "وَجِا۟یۤءَ یَوۡمَىِٕذِۭ بِجَهَنَّمَۚ یَوۡمَىِٕذࣲ یَتَذَكَّرُ ٱلۡإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ\n",
      "juz": 30,
      "page": 593,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 24,
      "text": "یَقُولُ یَـٰلَیۡتَنِی قَدَّمۡتُ لِحَیَاتِی\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 25,
      "text": "فَیَوۡمَىِٕذࣲ لَّا یُعَذِّبُ عَذَابَهُۥۤ أَحَدࣱ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 26,
      "text": "وَلَا یُوثِقُ وَثَاقَهُۥۤ أَحَدࣱ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 27,
      "text": "یَـٰۤأَیَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَىِٕنَّةُ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 28,
      "text": "ٱرۡجِعِیۤ إِلَىٰ رَبِّكِ رَاضِیَةࣰ مَّرۡضِیَّةࣰ\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 29,
      "text": "فَٱدۡخُلِی فِی عِبَـٰدِی\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    },
    {
      "numberInSurah": 30,
      "text": "وَٱدۡخُلِی جَنَّتِی\n",
      "juz": 30,
      "page": 594,
      "hizbQuarter": 237,
      "ruku": 531
    }
  ]
}