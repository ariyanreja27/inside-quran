{
  "surahNumber": 88,
  "surahName": "Al-Ghashiyah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ هَلۡ أَتَىٰكَ حَدِیثُ ٱلۡغَـٰشِیَةِ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 2,
      "text": "وُجُوهࣱ یَوۡمَىِٕذٍ خَـٰشِعَةٌ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 3,
      "text": "عَامِلَةࣱ نَّاصِبَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 4,
      "text": "تَصۡلَىٰ نَارًا حَامِیَةࣰ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 5,
      "text": "تُسۡقَىٰ مِنۡ عَیۡنٍ ءَانِیَةࣲ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 6,
      "text": "لَّیۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِیعࣲ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 7,
      "text": "لَّا یُسۡمِنُ وَلَا یُغۡنِی مِن جُوعࣲ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 8,
      "text": "وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاعِمَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 9,
      "text": "لِّسَعۡیِهَا رَاضِیَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 10,
      "text": "فِی جَنَّةٍ عَالِیَةࣲ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 11,
      "text": "لَّا تَسۡمَعُ فِیهَا لَـٰغِیَةࣰ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 12,
      "text": "فِیهَا عَیۡنࣱ جَارِیَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 13,
      "text": "فِیهَا سُرُرࣱ مَّرۡفُوعَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 14,
      "text": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 15,
      "text": "وَنَمَارِقُ مَصۡفُوفَةࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 16,
      "text": "وَزَرَابِیُّ مَبۡثُوثَةٌ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 17,
      "text": "أَفَلَا یَنظُرُونَ إِلَى ٱلۡإِبِلِ كَیۡفَ خُلِقَتۡ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 18,
      "text": "وَإِلَى ٱلسَّمَاۤءِ كَیۡفَ رُفِعَتۡ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 19,
      "text": "وَإِلَى ٱلۡجِبَالِ كَیۡفَ نُصِبَتۡ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 20,
      "text": "وَإِلَى ٱلۡأَرۡضِ كَیۡفَ سُطِحَتۡ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 21,
      "text": "فَذَكِّرۡ إِنَّمَاۤ أَنتَ مُذَكِّرࣱ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 22,
      "text": "لَّسۡتَ عَلَیۡهِم بِمُصَیۡطِرٍ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 23,
      "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 24,
      "text": "فَیُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 25,
      "text": "إِنَّ إِلَیۡنَاۤ إِیَابَهُمۡ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    },
    {
      "numberInSurah": 26,
      "text": "ثُمَّ إِنَّ عَلَیۡنَا حِسَابَهُم\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 530
    }
  ]
}