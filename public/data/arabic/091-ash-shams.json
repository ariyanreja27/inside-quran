{
  "surahNumber": 91,
  "surahName": "Ash-Shams",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلشَّمۡسِ وَضُحَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلۡقَمَرِ إِذَا تَلَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلَّیۡلِ إِذَا یَغۡشَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 5,
      "text": "وَٱلسَّمَاۤءِ وَمَا بَنَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 6,
      "text": "وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 7,
      "text": "وَنَفۡسࣲ وَمَا سَوَّىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 8,
      "text": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 9,
      "text": "قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 10,
      "text": "وَقَدۡ خَابَ مَن دَسَّىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 11,
      "text": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَاۤ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 12,
      "text": "إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 13,
      "text": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡیَـٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 14,
      "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَیۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    },
    {
      "numberInSurah": 15,
      "text": "وَلَا یَخَافُ عُقۡبَـٰهَا\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 533
    }
  ]
}