{
  "surahNumber": 92,
  "surahName": "Al-Layl",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلَّیۡلِ إِذَا یَغۡشَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 3,
      "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 4,
      "text": "إِنَّ سَعۡیَكُمۡ لَشَتَّىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 5,
      "text": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 6,
      "text": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 7,
      "text": "فَسَنُیَسِّرُهُۥ لِلۡیُسۡرَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 8,
      "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 9,
      "text": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 10,
      "text": "فَسَنُیَسِّرُهُۥ لِلۡعُسۡرَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 11,
      "text": "وَمَا یُغۡنِی عَنۡهُ مَالُهُۥۤ إِذَا تَرَدَّىٰۤ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 12,
      "text": "إِنَّ عَلَیۡنَا لَلۡهُدَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 13,
      "text": "وَإِنَّ لَنَا لَلۡـَٔاخِرَةَ وَٱلۡأُولَىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 14,
      "text": "فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ\n",
      "juz": 30,
      "page": 595,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 15,
      "text": "لَا یَصۡلَىٰهَاۤ إِلَّا ٱلۡأَشۡقَى\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 16,
      "text": "ٱلَّذِی كَذَّبَ وَتَوَلَّىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 17,
      "text": "وَسَیُجَنَّبُهَا ٱلۡأَتۡقَى\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 18,
      "text": "ٱلَّذِی یُؤۡتِی مَالَهُۥ یَتَزَكَّىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 19,
      "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰۤ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 20,
      "text": "إِلَّا ٱبۡتِغَاۤءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    },
    {
      "numberInSurah": 21,
      "text": "وَلَسَوۡفَ یَرۡضَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 534
    }
  ]
}