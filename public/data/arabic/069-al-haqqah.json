{
  "surahNumber": 69,
  "surahName": "Al-Haqqah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلۡحَاۤقَّةُ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 2,
      "text": "مَا ٱلۡحَاۤقَّةُ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 3,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡحَاۤقَّةُ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 4,
      "text": "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 5,
      "text": "فَأَمَّا ثَمُودُ فَأُهۡلِكُوا۟ بِٱلطَّاغِیَةِ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 6,
      "text": "وَأَمَّا عَادࣱ فَأُهۡلِكُوا۟ بِرِیحࣲ صَرۡصَرٍ عَاتِیَةࣲ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 7,
      "text": "سَخَّرَهَا عَلَیۡهِمۡ سَبۡعَ لَیَالࣲ وَثَمَـٰنِیَةَ أَیَّامٍ حُسُومࣰاۖ فَتَرَى ٱلۡقَوۡمَ فِیهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِیَةࣲ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 8,
      "text": "فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِیَةࣲ\n",
      "juz": 29,
      "page": 566,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 9,
      "text": "وَجَاۤءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَـٰتُ بِٱلۡخَاطِئَةِ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 10,
      "text": "فَعَصَوۡا۟ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةࣰ رَّابِیَةً\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 11,
      "text": "إِنَّا لَمَّا طَغَا ٱلۡمَاۤءُ حَمَلۡنَـٰكُمۡ فِی ٱلۡجَارِیَةِ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 12,
      "text": "لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةࣰ وَتَعِیَهَاۤ أُذُنࣱ وَ ٰ⁠عِیَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 13,
      "text": "فَإِذَا نُفِخَ فِی ٱلصُّورِ نَفۡخَةࣱ وَ ٰ⁠حِدَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 14,
      "text": "وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةࣰ وَ ٰ⁠حِدَةࣰ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 15,
      "text": "فَیَوۡمَىِٕذࣲ وَقَعَتِ ٱلۡوَاقِعَةُ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 16,
      "text": "وَٱنشَقَّتِ ٱلسَّمَاۤءُ فَهِیَ یَوۡمَىِٕذࣲ وَاهِیَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 17,
      "text": "وَٱلۡمَلَكُ عَلَىٰۤ أَرۡجَاۤىِٕهَاۚ وَیَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ یَوۡمَىِٕذࣲ ثَمَـٰنِیَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 18,
      "text": "یَوۡمَىِٕذࣲ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِیَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 19,
      "text": "فَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِیَمِینِهِۦ فَیَقُولُ هَاۤؤُمُ ٱقۡرَءُوا۟ كِتَـٰبِیَهۡ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 20,
      "text": "إِنِّی ظَنَنتُ أَنِّی مُلَـٰقٍ حِسَابِیَهۡ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 21,
      "text": "فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 22,
      "text": "فِی جَنَّةٍ عَالِیَةࣲ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 23,
      "text": "قُطُوفُهَا دَانِیَةࣱ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 24,
      "text": "كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَاۤ أَسۡلَفۡتُمۡ فِی ٱلۡأَیَّامِ ٱلۡخَالِیَةِ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 25,
      "text": "وَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَیَقُولُ یَـٰلَیۡتَنِی لَمۡ أُوتَ كِتَـٰبِیَهۡ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 26,
      "text": "وَلَمۡ أَدۡرِ مَا حِسَابِیَهۡ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 27,
      "text": "یَـٰلَیۡتَهَا كَانَتِ ٱلۡقَاضِیَةَ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 28,
      "text": "مَاۤ أَغۡنَىٰ عَنِّی مَالِیَهۡۜ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 29,
      "text": "هَلَكَ عَنِّی سُلۡطَـٰنِیَهۡ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 30,
      "text": "خُذُوهُ فَغُلُّوهُ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 31,
      "text": "ثُمَّ ٱلۡجَحِیمَ صَلُّوهُ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 32,
      "text": "ثُمَّ فِی سِلۡسِلَةࣲ ذَرۡعُهَا سَبۡعُونَ ذِرَاعࣰا فَٱسۡلُكُوهُ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 33,
      "text": "إِنَّهُۥ كَانَ لَا یُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِیمِ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 34,
      "text": "وَلَا یَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِینِ\n",
      "juz": 29,
      "page": 567,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 35,
      "text": "فَلَیۡسَ لَهُ ٱلۡیَوۡمَ هَـٰهُنَا حَمِیمࣱ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 36,
      "text": "وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِینࣲ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 37,
      "text": "لَّا یَأۡكُلُهُۥۤ إِلَّا ٱلۡخَـٰطِـُٔونَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 500
    },
    {
      "numberInSurah": 38,
      "text": "فَلَاۤ أُقۡسِمُ بِمَا تُبۡصِرُونَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 39,
      "text": "وَمَا لَا تُبۡصِرُونَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 40,
      "text": "إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِیمࣲ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 41,
      "text": "وَمَا هُوَ بِقَوۡلِ شَاعِرࣲۚ قَلِیلࣰا مَّا تُؤۡمِنُونَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 42,
      "text": "وَلَا بِقَوۡلِ كَاهِنࣲۚ قَلِیلࣰا مَّا تَذَكَّرُونَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 43,
      "text": "تَنزِیلࣱ مِّن رَّبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 44,
      "text": "وَلَوۡ تَقَوَّلَ عَلَیۡنَا بَعۡضَ ٱلۡأَقَاوِیلِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 45,
      "text": "لَأَخَذۡنَا مِنۡهُ بِٱلۡیَمِینِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 46,
      "text": "ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 47,
      "text": "فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَـٰجِزِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 48,
      "text": "وَإِنَّهُۥ لَتَذۡكِرَةࣱ لِّلۡمُتَّقِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 49,
      "text": "وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 50,
      "text": "وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَـٰفِرِینَ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 51,
      "text": "وَإِنَّهُۥ لَحَقُّ ٱلۡیَقِینِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    },
    {
      "numberInSurah": 52,
      "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ\n",
      "juz": 29,
      "page": 568,
      "hizbQuarter": 227,
      "ruku": 501
    }
  ]
}