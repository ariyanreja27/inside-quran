{
  "surahNumber": 86,
  "surahName": "At-Tariq",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلسَّمَاۤءِ وَٱلطَّارِقِ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 2,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلطَّارِقُ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 3,
      "text": "ٱلنَّجۡمُ ٱلثَّاقِبُ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 4,
      "text": "إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَیۡهَا حَافِظࣱ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 5,
      "text": "فَلۡیَنظُرِ ٱلۡإِنسَـٰنُ مِمَّ خُلِقَ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 6,
      "text": "خُلِقَ مِن مَّاۤءࣲ دَافِقࣲ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 7,
      "text": "یَخۡرُجُ مِنۢ بَیۡنِ ٱلصُّلۡبِ وَٱلتَّرَاۤىِٕبِ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 9,
      "text": "یَوۡمَ تُبۡلَى ٱلسَّرَاۤىِٕرُ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 10,
      "text": "فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 11,
      "text": "وَٱلسَّمَاۤءِ ذَاتِ ٱلرَّجۡعِ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 12,
      "text": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 13,
      "text": "إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 14,
      "text": "وَمَا هُوَ بِٱلۡهَزۡلِ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 15,
      "text": "إِنَّهُمۡ یَكِیدُونَ كَیۡدࣰا\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 16,
      "text": "وَأَكِیدُ كَیۡدࣰا\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    },
    {
      "numberInSurah": 17,
      "text": "فَمَهِّلِ ٱلۡكَـٰفِرِینَ أَمۡهِلۡهُمۡ رُوَیۡدَۢا\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 236,
      "ruku": 528
    }
  ]
}