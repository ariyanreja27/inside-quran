{
  "surahNumber": 51,
  "surahName": "Adh-Dhariyat",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلذَّ ٰ⁠رِیَـٰتِ ذَرۡوࣰا\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 2,
      "text": "فَٱلۡحَـٰمِلَـٰتِ وِقۡرࣰا\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 3,
      "text": "فَٱلۡجَـٰرِیَـٰتِ یُسۡرࣰا\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 4,
      "text": "فَٱلۡمُقَسِّمَـٰتِ أَمۡرًا\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 5,
      "text": "إِنَّمَا تُوعَدُونَ لَصَادِقࣱ\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 6,
      "text": "وَإِنَّ ٱلدِّینَ لَوَ ٰ⁠قِعࣱ\n",
      "juz": 26,
      "page": 520,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 7,
      "text": "وَٱلسَّمَاۤءِ ذَاتِ ٱلۡحُبُكِ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّكُمۡ لَفِی قَوۡلࣲ مُّخۡتَلِفࣲ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 9,
      "text": "یُؤۡفَكُ عَنۡهُ مَنۡ أُفِكَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 10,
      "text": "قُتِلَ ٱلۡخَرَّ ٰ⁠صُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 11,
      "text": "ٱلَّذِینَ هُمۡ فِی غَمۡرَةࣲ سَاهُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 12,
      "text": "یَسۡـَٔلُونَ أَیَّانَ یَوۡمُ ٱلدِّینِ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 13,
      "text": "یَوۡمَ هُمۡ عَلَى ٱلنَّارِ یُفۡتَنُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 14,
      "text": "ذُوقُوا۟ فِتۡنَتَكُمۡ هَـٰذَا ٱلَّذِی كُنتُم بِهِۦ تَسۡتَعۡجِلُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 15,
      "text": "إِنَّ ٱلۡمُتَّقِینَ فِی جَنَّـٰتࣲ وَعُیُونٍ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 16,
      "text": "ءَاخِذِینَ مَاۤ ءَاتَىٰهُمۡ رَبُّهُمۡۚ إِنَّهُمۡ كَانُوا۟ قَبۡلَ ذَ ٰ⁠لِكَ مُحۡسِنِینَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 17,
      "text": "كَانُوا۟ قَلِیلࣰا مِّنَ ٱلَّیۡلِ مَا یَهۡجَعُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 18,
      "text": "وَبِٱلۡأَسۡحَارِ هُمۡ یَسۡتَغۡفِرُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 19,
      "text": "وَفِیۤ أَمۡوَ ٰ⁠لِهِمۡ حَقࣱّ لِّلسَّاۤىِٕلِ وَٱلۡمَحۡرُومِ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 20,
      "text": "وَفِی ٱلۡأَرۡضِ ءَایَـٰتࣱ لِّلۡمُوقِنِینَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 21,
      "text": "وَفِیۤ أَنفُسِكُمۡۚ أَفَلَا تُبۡصِرُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 22,
      "text": "وَفِی ٱلسَّمَاۤءِ رِزۡقُكُمۡ وَمَا تُوعَدُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 23,
      "text": "فَوَرَبِّ ٱلسَّمَاۤءِ وَٱلۡأَرۡضِ إِنَّهُۥ لَحَقࣱّ مِّثۡلَ مَاۤ أَنَّكُمۡ تَنطِقُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 455
    },
    {
      "numberInSurah": 24,
      "text": "هَلۡ أَتَىٰكَ حَدِیثُ ضَیۡفِ إِبۡرَ ٰ⁠هِیمَ ٱلۡمُكۡرَمِینَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 25,
      "text": "إِذۡ دَخَلُوا۟ عَلَیۡهِ فَقَالُوا۟ سَلَـٰمࣰاۖ قَالَ سَلَـٰمࣱ قَوۡمࣱ مُّنكَرُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 26,
      "text": "فَرَاغَ إِلَىٰۤ أَهۡلِهِۦ فَجَاۤءَ بِعِجۡلࣲ سَمِینࣲ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 27,
      "text": "فَقَرَّبَهُۥۤ إِلَیۡهِمۡ قَالَ أَلَا تَأۡكُلُونَ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 28,
      "text": "فَأَوۡجَسَ مِنۡهُمۡ خِیفَةࣰۖ قَالُوا۟ لَا تَخَفۡۖ وَبَشَّرُوهُ بِغُلَـٰمٍ عَلِیمࣲ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 29,
      "text": "فَأَقۡبَلَتِ ٱمۡرَأَتُهُۥ فِی صَرَّةࣲ فَصَكَّتۡ وَجۡهَهَا وَقَالَتۡ عَجُوزٌ عَقِیمࣱ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 30,
      "text": "قَالُوا۟ كَذَ ٰ⁠لِكِ قَالَ رَبُّكِۖ إِنَّهُۥ هُوَ ٱلۡحَكِیمُ ٱلۡعَلِیمُ\n",
      "juz": 26,
      "page": 521,
      "hizbQuarter": 208,
      "ruku": 456
    },
    {
      "numberInSurah": 31,
      "text": "۞ قَالَ فَمَا خَطۡبُكُمۡ أَیُّهَا ٱلۡمُرۡسَلُونَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 32,
      "text": "قَالُوۤا۟ إِنَّاۤ أُرۡسِلۡنَاۤ إِلَىٰ قَوۡمࣲ مُّجۡرِمِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 33,
      "text": "لِنُرۡسِلَ عَلَیۡهِمۡ حِجَارَةࣰ مِّن طِینࣲ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 34,
      "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلۡمُسۡرِفِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 35,
      "text": "فَأَخۡرَجۡنَا مَن كَانَ فِیهَا مِنَ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 36,
      "text": "فَمَا وَجَدۡنَا فِیهَا غَیۡرَ بَیۡتࣲ مِّنَ ٱلۡمُسۡلِمِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 37,
      "text": "وَتَرَكۡنَا فِیهَاۤ ءَایَةࣰ لِّلَّذِینَ یَخَافُونَ ٱلۡعَذَابَ ٱلۡأَلِیمَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 38,
      "text": "وَفِی مُوسَىٰۤ إِذۡ أَرۡسَلۡنَـٰهُ إِلَىٰ فِرۡعَوۡنَ بِسُلۡطَـٰنࣲ مُّبِینࣲ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 39,
      "text": "فَتَوَلَّىٰ بِرُكۡنِهِۦ وَقَالَ سَـٰحِرٌ أَوۡ مَجۡنُونࣱ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 40,
      "text": "فَأَخَذۡنَـٰهُ وَجُنُودَهُۥ فَنَبَذۡنَـٰهُمۡ فِی ٱلۡیَمِّ وَهُوَ مُلِیمࣱ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 41,
      "text": "وَفِی عَادٍ إِذۡ أَرۡسَلۡنَا عَلَیۡهِمُ ٱلرِّیحَ ٱلۡعَقِیمَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 42,
      "text": "مَا تَذَرُ مِن شَیۡءٍ أَتَتۡ عَلَیۡهِ إِلَّا جَعَلَتۡهُ كَٱلرَّمِیمِ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 43,
      "text": "وَفِی ثَمُودَ إِذۡ قِیلَ لَهُمۡ تَمَتَّعُوا۟ حَتَّىٰ حِینࣲ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 44,
      "text": "فَعَتَوۡا۟ عَنۡ أَمۡرِ رَبِّهِمۡ فَأَخَذَتۡهُمُ ٱلصَّـٰعِقَةُ وَهُمۡ یَنظُرُونَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 45,
      "text": "فَمَا ٱسۡتَطَـٰعُوا۟ مِن قِیَامࣲ وَمَا كَانُوا۟ مُنتَصِرِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 46,
      "text": "وَقَوۡمَ نُوحࣲ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُوا۟ قَوۡمࣰا فَـٰسِقِینَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 456
    },
    {
      "numberInSurah": 47,
      "text": "وَٱلسَّمَاۤءَ بَنَیۡنَـٰهَا بِأَیۡی۟دࣲ وَإِنَّا لَمُوسِعُونَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 48,
      "text": "وَٱلۡأَرۡضَ فَرَشۡنَـٰهَا فَنِعۡمَ ٱلۡمَـٰهِدُونَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 49,
      "text": "وَمِن كُلِّ شَیۡءٍ خَلَقۡنَا زَوۡجَیۡنِ لَعَلَّكُمۡ تَذَكَّرُونَ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 50,
      "text": "فَفِرُّوۤا۟ إِلَى ٱللَّهِۖ إِنِّی لَكُم مِّنۡهُ نَذِیرࣱ مُّبِینࣱ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 51,
      "text": "وَلَا تَجۡعَلُوا۟ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَۖ إِنِّی لَكُم مِّنۡهُ نَذِیرࣱ مُّبِینࣱ\n",
      "juz": 27,
      "page": 522,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 52,
      "text": "كَذَ ٰ⁠لِكَ مَاۤ أَتَى ٱلَّذِینَ مِن قَبۡلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوۡ مَجۡنُونٌ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 53,
      "text": "أَتَوَاصَوۡا۟ بِهِۦۚ بَلۡ هُمۡ قَوۡمࣱ طَاغُونَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 54,
      "text": "فَتَوَلَّ عَنۡهُمۡ فَمَاۤ أَنتَ بِمَلُومࣲ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 55,
      "text": "وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 56,
      "text": "وَمَا خَلَقۡتُ ٱلۡجِنَّ وَٱلۡإِنسَ إِلَّا لِیَعۡبُدُونِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 57,
      "text": "مَاۤ أُرِیدُ مِنۡهُم مِّن رِّزۡقࣲ وَمَاۤ أُرِیدُ أَن یُطۡعِمُونِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 58,
      "text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلۡقُوَّةِ ٱلۡمَتِینُ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 59,
      "text": "فَإِنَّ لِلَّذِینَ ظَلَمُوا۟ ذَنُوبࣰا مِّثۡلَ ذَنُوبِ أَصۡحَـٰبِهِمۡ فَلَا یَسۡتَعۡجِلُونِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    },
    {
      "numberInSurah": 60,
      "text": "فَوَیۡلࣱ لِّلَّذِینَ كَفَرُوا۟ مِن یَوۡمِهِمُ ٱلَّذِی یُوعَدُونَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 457
    }
  ]
}