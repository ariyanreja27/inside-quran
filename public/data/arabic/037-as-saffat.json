    },
    {
      "numberInSurah": 133,
      "text": "وَإِنَّ لُوطࣰا لَّمِنَ ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 134,
      "text": "إِذۡ نَجَّیۡنَـٰهُ وَأَهۡلَهُۥۤ أَجۡمَعِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 135,
      "text": "إِلَّا عَجُوزࣰا فِی ٱلۡغَـٰبِرِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 136,
      "text": "ثُمَّ دَمَّرۡنَا ٱلۡـَٔاخَرِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 137,
      "text": "وَإِنَّكُمۡ لَتَمُرُّونَ عَلَیۡهِم مُّصۡبِحِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 138,
      "text": "وَبِٱلَّیۡلِۚ أَفَلَا تَعۡقِلُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 139,
      "text": "وَإِنَّ یُونُسَ لَمِنَ ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 140,
      "text": "إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 141,
      "text": "فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 142,
      "text": "فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِیمࣱ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 143,
      "text": "فَلَوۡلَاۤ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 144,
      "text": "لَلَبِثَ فِی بَطۡنِهِۦۤ إِلَىٰ یَوۡمِ یُبۡعَثُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 390
    },
    {
      "numberInSurah": 145,
      "text": "۞ فَنَبَذۡنَـٰهُ بِٱلۡعَرَاۤءِ وَهُوَ سَقِیمࣱ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 146,
      "text": "وَأَنۢبَتۡنَا عَلَیۡهِ شَجَرَةࣰ مِّن یَقۡطِینࣲ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 147,
      "text": "وَأَرۡسَلۡنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلۡفٍ أَوۡ یَزِیدُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 148,
      "text": "فَـَٔامَنُوا۟ فَمَتَّعۡنَـٰهُمۡ إِلَىٰ حِینࣲ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 149,
      "text": "فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 150,
      "text": "أَمۡ خَلَقۡنَا ٱلۡمَلَـٰۤىِٕكَةَ إِنَـٰثࣰا وَهُمۡ شَـٰهِدُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 151,
      "text": "أَلَاۤ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَیَقُولُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 152,
      "text": "وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَـٰذِبُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 153,
      "text": "أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 154,
      "text": "مَا لَكُمۡ كَیۡفَ تَحۡكُمُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 155,
      "text": "أَفَلَا تَذَكَّرُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 156,
      "text": "أَمۡ لَكُمۡ سُلۡطَـٰنࣱ مُّبِینࣱ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 157,
      "text": "فَأۡتُوا۟ بِكِتَـٰبِكُمۡ إِن كُنتُمۡ صَـٰدِقِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 158,
      "text": "وَجَعَلُوا۟ بَیۡنَهُۥ وَبَیۡنَ ٱلۡجِنَّةِ نَسَبࣰاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 159,
      "text": "سُبۡحَـٰنَ ٱللَّهِ عَمَّا یَصِفُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 160,
      "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 161,
      "text": "فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 162,
      "text": "مَاۤ أَنتُمۡ عَلَیۡهِ بِفَـٰتِنِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 163,
      "text": "إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 164,
      "text": "وَمَا مِنَّاۤ إِلَّا لَهُۥ مَقَامࣱ مَّعۡلُومࣱ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 165,
      "text": "وَإِنَّا لَنَحۡنُ ٱلصَّاۤفُّونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 166,
      "text": "وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 167,
      "text": "وَإِن كَانُوا۟ لَیَقُولُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 168,
      "text": "لَوۡ أَنَّ عِندَنَا ذِكۡرࣰا مِّنَ ٱلۡأَوَّلِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 169,
      "text": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 170,
      "text": "فَكَفَرُوا۟ بِهِۦۖ فَسَوۡفَ یَعۡلَمُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 171,
      "text": "وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 172,
      "text": "إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 173,
      "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَـٰلِبُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 174,
      "text": "فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِینࣲ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 175,
      "text": "وَأَبۡصِرۡهُمۡ فَسَوۡفَ یُبۡصِرُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 176,
      "text": "أَفَبِعَذَابِنَا یَسۡتَعۡجِلُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 177,
      "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَاۤءَ صَبَاحُ ٱلۡمُنذَرِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 178,
      "text": "وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِینࣲ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 179,
      "text": "وَأَبۡصِرۡ فَسَوۡفَ یُبۡصِرُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 180,
      "text": "سُبۡحَـٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا یَصِفُونَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 181,
      "text": "وَسَلَـٰمٌ عَلَى ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    },
    {
      "numberInSurah": 182,
      "text": "وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 23,
      "page": 452,
      "hizbQuarter": 181,
      "ruku": 390
    }
  ]
}