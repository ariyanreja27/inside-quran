{
  "surahNumber": 37,
  "surahName": "As-Saffat",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلصَّـٰۤفَّـٰتِ صَفࣰّا\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 2,
      "text": "فَٱلزَّ ٰ⁠جِرَ ٰ⁠تِ زَجۡرࣰا\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 3,
      "text": "فَٱلتَّـٰلِیَـٰتِ ذِكۡرًا\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 4,
      "text": "إِنَّ إِلَـٰهَكُمۡ لَوَ ٰ⁠حِدࣱ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 5,
      "text": "رَّبُّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَا وَرَبُّ ٱلۡمَشَـٰرِقِ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 6,
      "text": "إِنَّا زَیَّنَّا ٱلسَّمَاۤءَ ٱلدُّنۡیَا بِزِینَةٍ ٱلۡكَوَاكِبِ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 7,
      "text": "وَحِفۡظࣰا مِّن كُلِّ شَیۡطَـٰنࣲ مَّارِدࣲ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 8,
      "text": "لَّا یَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَیُقۡذَفُونَ مِن كُلِّ جَانِبࣲ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 9,
      "text": "دُحُورࣰاۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 10,
      "text": "إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 11,
      "text": "فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَاۤۚ إِنَّا خَلَقۡنَـٰهُم مِّن طِینࣲ لَّازِبِۭ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 12,
      "text": "بَلۡ عَجِبۡتَ وَیَسۡخَرُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 13,
      "text": "وَإِذَا ذُكِّرُوا۟ لَا یَذۡكُرُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 14,
      "text": "وَإِذَا رَأَوۡا۟ ءَایَةࣰ یَسۡتَسۡخِرُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 15,
      "text": "وَقَالُوۤا۟ إِنۡ هَـٰذَاۤ إِلَّا سِحۡرࣱ مُّبِینٌ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 16,
      "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَبۡعُوثُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 17,
      "text": "أَوَءَابَاۤؤُنَا ٱلۡأَوَّلُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 18,
      "text": "قُلۡ نَعَمۡ وَأَنتُمۡ دَ ٰ⁠خِرُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 19,
      "text": "فَإِنَّمَا هِیَ زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ فَإِذَا هُمۡ یَنظُرُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 20,
      "text": "وَقَالُوا۟ یَـٰوَیۡلَنَا هَـٰذَا یَوۡمُ ٱلدِّینِ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 21,
      "text": "هَـٰذَا یَوۡمُ ٱلۡفَصۡلِ ٱلَّذِی كُنتُم بِهِۦ تُكَذِّبُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 178,
      "ruku": 386
    },
    {
      "numberInSurah": 22,
      "text": "۞ ٱحۡشُرُوا۟ ٱلَّذِینَ ظَلَمُوا۟ وَأَزۡوَ ٰ⁠جَهُمۡ وَمَا كَانُوا۟ یَعۡبُدُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 23,
      "text": "مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَ ٰ⁠طِ ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 24,
      "text": "وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ\n",
      "juz": 23,
      "page": 446,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 25,
      "text": "مَا لَكُمۡ لَا تَنَاصَرُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 26,
      "text": "بَلۡ هُمُ ٱلۡیَوۡمَ مُسۡتَسۡلِمُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 27,
      "text": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ یَتَسَاۤءَلُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 28,
      "text": "قَالُوۤا۟ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡیَمِینِ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 29,
      "text": "قَالُوا۟ بَل لَّمۡ تَكُونُوا۟ مُؤۡمِنِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 30,
      "text": "وَمَا كَانَ لَنَا عَلَیۡكُم مِّن سُلۡطَـٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰا طَـٰغِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 31,
      "text": "فَحَقَّ عَلَیۡنَا قَوۡلُ رَبِّنَاۤۖ إِنَّا لَذَاۤىِٕقُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 32,
      "text": "فَأَغۡوَیۡنَـٰكُمۡ إِنَّا كُنَّا غَـٰوِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 33,
      "text": "فَإِنَّهُمۡ یَوۡمَىِٕذࣲ فِی ٱلۡعَذَابِ مُشۡتَرِكُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 34,
      "text": "إِنَّا كَذَ ٰ⁠لِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 35,
      "text": "إِنَّهُمۡ كَانُوۤا۟ إِذَا قِیلَ لَهُمۡ لَاۤ إِلَـٰهَ إِلَّا ٱللَّهُ یَسۡتَكۡبِرُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 36,
      "text": "وَیَقُولُونَ أَىِٕنَّا لَتَارِكُوۤا۟ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 37,
      "text": "بَلۡ جَاۤءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 38,
      "text": "إِنَّكُمۡ لَذَاۤىِٕقُوا۟ ٱلۡعَذَابِ ٱلۡأَلِیمِ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 39,
      "text": "وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 40,
      "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 41,
      "text": "أُو۟لَـٰۤىِٕكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 42,
      "text": "فَوَ ٰ⁠كِهُ وَهُم مُّكۡرَمُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 43,
      "text": "فِی جَنَّـٰتِ ٱلنَّعِیمِ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 44,
      "text": "عَلَىٰ سُرُرࣲ مُّتَقَـٰبِلِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 45,
      "text": "یُطَافُ عَلَیۡهِم بِكَأۡسࣲ مِّن مَّعِینِۭ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 46,
      "text": "بَیۡضَاۤءَ لَذَّةࣲ لِّلشَّـٰرِبِینَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 47,
      "text": "لَا فِیهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا یُنزَفُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 48,
      "text": "وَعِندَهُمۡ قَـٰصِرَ ٰ⁠تُ ٱلطَّرۡفِ عِینࣱ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 49,
      "text": "كَأَنَّهُنَّ بَیۡضࣱ مَّكۡنُونࣱ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 50,
      "text": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ یَتَسَاۤءَلُونَ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 51,
      "text": "قَالَ قَاۤىِٕلࣱ مِّنۡهُمۡ إِنِّی كَانَ لِی قَرِینࣱ\n",
      "juz": 23,
      "page": 447,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 52,
      "text": "یَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 53,
      "text": "أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَدِینُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 54,
      "text": "قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 55,
      "text": "فَٱطَّلَعَ فَرَءَاهُ فِی سَوَاۤءِ ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 56,
      "text": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِینِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 57,
      "text": "وَلَوۡلَا نِعۡمَةُ رَبِّی لَكُنتُ مِنَ ٱلۡمُحۡضَرِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 58,
      "text": "أَفَمَا نَحۡنُ بِمَیِّتِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 59,
      "text": "إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 60,
      "text": "إِنَّ هَـٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِیمُ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 61,
      "text": "لِمِثۡلِ هَـٰذَا فَلۡیَعۡمَلِ ٱلۡعَـٰمِلُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 62,
      "text": "أَذَ ٰ⁠لِكَ خَیۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 63,
      "text": "إِنَّا جَعَلۡنَـٰهَا فِتۡنَةࣰ لِّلظَّـٰلِمِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 64,
      "text": "إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِیۤ أَصۡلِ ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 65,
      "text": "طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّیَـٰطِینِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 66,
      "text": "فَإِنَّهُمۡ لَـَٔاكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 67,
      "text": "ثُمَّ إِنَّ لَهُمۡ عَلَیۡهَا لَشَوۡبࣰا مِّنۡ حَمِیمࣲ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 68,
      "text": "ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 69,
      "text": "إِنَّهُمۡ أَلۡفَوۡا۟ ءَابَاۤءَهُمۡ ضَاۤلِّینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 70,
      "text": "فَهُمۡ عَلَىٰۤ ءَاثَـٰرِهِمۡ یُهۡرَعُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 71,
      "text": "وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 72,
      "text": "وَلَقَدۡ أَرۡسَلۡنَا فِیهِم مُّنذِرِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 73,
      "text": "فَٱنظُرۡ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُنذَرِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 74,
      "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 387
    },
    {
      "numberInSurah": 75,
      "text": "وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِیبُونَ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 76,
      "text": "وَنَجَّیۡنَـٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِیمِ\n",
      "juz": 23,
      "page": 448,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 77,
      "text": "وَجَعَلۡنَا ذُرِّیَّتَهُۥ هُمُ ٱلۡبَاقِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 78,
      "text": "وَتَرَكۡنَا عَلَیۡهِ فِی ٱلۡـَٔاخِرِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 79,
      "text": "سَلَـٰمٌ عَلَىٰ نُوحࣲ فِی ٱلۡعَـٰلَمِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 80,
      "text": "إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 81,
      "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 82,
      "text": "ثُمَّ أَغۡرَقۡنَا ٱلۡـَٔاخَرِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 179,
      "ruku": 388
    },
    {
      "numberInSurah": 83,
      "text": "۞ وَإِنَّ مِن شِیعَتِهِۦ لَإِبۡرَ ٰ⁠هِیمَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 84,
      "text": "إِذۡ جَاۤءَ رَبَّهُۥ بِقَلۡبࣲ سَلِیمٍ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 85,
      "text": "إِذۡ قَالَ لِأَبِیهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 86,
      "text": "أَىِٕفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِیدُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 87,
      "text": "فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 88,
      "text": "فَنَظَرَ نَظۡرَةࣰ فِی ٱلنُّجُومِ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 89,
      "text": "فَقَالَ إِنِّی سَقِیمࣱ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 90,
      "text": "فَتَوَلَّوۡا۟ عَنۡهُ مُدۡبِرِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 91,
      "text": "فَرَاغَ إِلَىٰۤ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 92,
      "text": "مَا لَكُمۡ لَا تَنطِقُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 93,
      "text": "فَرَاغَ عَلَیۡهِمۡ ضَرۡبَۢا بِٱلۡیَمِینِ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 94,
      "text": "فَأَقۡبَلُوۤا۟ إِلَیۡهِ یَزِفُّونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 95,
      "text": "قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 96,
      "text": "وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 97,
      "text": "قَالُوا۟ ٱبۡنُوا۟ لَهُۥ بُنۡیَـٰنࣰا فَأَلۡقُوهُ فِی ٱلۡجَحِیمِ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 98,
      "text": "فَأَرَادُوا۟ بِهِۦ كَیۡدࣰا فَجَعَلۡنَـٰهُمُ ٱلۡأَسۡفَلِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 99,
      "text": "وَقَالَ إِنِّی ذَاهِبٌ إِلَىٰ رَبِّی سَیَهۡدِینِ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 100,
      "text": "رَبِّ هَبۡ لِی مِنَ ٱلصَّـٰلِحِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 101,
      "text": "فَبَشَّرۡنَـٰهُ بِغُلَـٰمٍ حَلِیمࣲ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 102,
      "text": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡیَ قَالَ یَـٰبُنَیَّ إِنِّیۤ أَرَىٰ فِی ٱلۡمَنَامِ أَنِّیۤ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ یَـٰۤأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِیۤ إِن شَاۤءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِینَ\n",
      "juz": 23,
      "page": 449,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 103,
      "text": "فَلَمَّاۤ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِینِ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 104,
      "text": "وَنَـٰدَیۡنَـٰهُ أَن یَـٰۤإِبۡرَ ٰ⁠هِیمُ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 105,
      "text": "قَدۡ صَدَّقۡتَ ٱلرُّءۡیَاۤۚ إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 106,
      "text": "إِنَّ هَـٰذَا لَهُوَ ٱلۡبَلَـٰۤؤُا۟ ٱلۡمُبِینُ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 107,
      "text": "وَفَدَیۡنَـٰهُ بِذِبۡحٍ عَظِیمࣲ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 108,
      "text": "وَتَرَكۡنَا عَلَیۡهِ فِی ٱلۡـَٔاخِرِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 109,
      "text": "سَلَـٰمٌ عَلَىٰۤ إِبۡرَ ٰ⁠هِیمَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 110,
      "text": "كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 111,
      "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 112,
      "text": "وَبَشَّرۡنَـٰهُ بِإِسۡحَـٰقَ نَبِیࣰّا مِّنَ ٱلصَّـٰلِحِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 113,
      "text": "وَبَـٰرَكۡنَا عَلَیۡهِ وَعَلَىٰۤ إِسۡحَـٰقَۚ وَمِن ذُرِّیَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِینࣱ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 388
    },
    {
      "numberInSurah": 114,
      "text": "وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 115,
      "text": "وَنَجَّیۡنَـٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِیمِ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 116,
      "text": "وَنَصَرۡنَـٰهُمۡ فَكَانُوا۟ هُمُ ٱلۡغَـٰلِبِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 117,
      "text": "وَءَاتَیۡنَـٰهُمَا ٱلۡكِتَـٰبَ ٱلۡمُسۡتَبِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 118,
      "text": "وَهَدَیۡنَـٰهُمَا ٱلصِّرَ ٰ⁠طَ ٱلۡمُسۡتَقِیمَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 119,
      "text": "وَتَرَكۡنَا عَلَیۡهِمَا فِی ٱلۡـَٔاخِرِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 120,
      "text": "سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 121,
      "text": "إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 122,
      "text": "إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 123,
      "text": "وَإِنَّ إِلۡیَاسَ لَمِنَ ٱلۡمُرۡسَلِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 124,
      "text": "إِذۡ قَالَ لِقَوۡمِهِۦۤ أَلَا تَتَّقُونَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 125,
      "text": "أَتَدۡعُونَ بَعۡلࣰا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَـٰلِقِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 126,
      "text": "ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَاۤىِٕكُمُ ٱلۡأَوَّلِینَ\n",
      "juz": 23,
      "page": 450,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 127,
      "text": "فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 128,
      "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 129,
      "text": "وَتَرَكۡنَا عَلَیۡهِ فِی ٱلۡـَٔاخِرِینَ\n",
      "juz": 23,
      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 130,
      "text": "سَلَـٰمٌ عَلَىٰۤ إِلۡ یَاسِینَ\n",
