      "page": 451,
      "hizbQuarter": 180,
      "ruku": 389
    },
    {
      "numberInSurah": 132,
      "text": "إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِینَ\n",
