{
  "surahNumber": 82,
  "surahName": "Al-Infitar",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلسَّمَاۤءُ ٱنفَطَرَتۡ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 2,
      "text": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 3,
      "text": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 4,
      "text": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 5,
      "text": "عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 6,
      "text": "یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِیمِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 7,
      "text": "ٱلَّذِی خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 8,
      "text": "فِیۤ أَیِّ صُورَةࣲ مَّا شَاۤءَ رَكَّبَكَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 9,
      "text": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّینِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 10,
      "text": "وَإِنَّ عَلَیۡكُمۡ لَحَـٰفِظِینَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 11,
      "text": "كِرَامࣰا كَـٰتِبِینَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 12,
      "text": "یَعۡلَمُونَ مَا تَفۡعَلُونَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 13,
      "text": "إِنَّ ٱلۡأَبۡرَارَ لَفِی نَعِیمࣲ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 14,
      "text": "وَإِنَّ ٱلۡفُجَّارَ لَفِی جَحِیمࣲ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 15,
      "text": "یَصۡلَوۡنَهَا یَوۡمَ ٱلدِّینِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 16,
      "text": "وَمَا هُمۡ عَنۡهَا بِغَاۤىِٕبِینَ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 17,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 18,
      "text": "ثُمَّ مَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلدِّینِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    },
    {
      "numberInSurah": 19,
      "text": "یَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَیۡـࣰٔاۖ وَٱلۡأَمۡرُ یَوۡمَىِٕذࣲ لِّلَّهِ\n",
      "juz": 30,
      "page": 587,
      "hizbQuarter": 235,
      "ruku": 524
    }
  ]
}