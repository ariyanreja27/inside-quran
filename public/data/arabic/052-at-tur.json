{
  "surahNumber": 52,
  "surahName": "At-Tur",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلطُّورِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 2,
      "text": "وَكِتَـٰبࣲ مَّسۡطُورࣲ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 3,
      "text": "فِی رَقࣲّ مَّنشُورࣲ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلۡبَیۡتِ ٱلۡمَعۡمُورِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 5,
      "text": "وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 6,
      "text": "وَٱلۡبَحۡرِ ٱلۡمَسۡجُورِ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 7,
      "text": "إِنَّ عَذَابَ رَبِّكَ لَوَ ٰ⁠قِعࣱ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 8,
      "text": "مَّا لَهُۥ مِن دَافِعࣲ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 9,
      "text": "یَوۡمَ تَمُورُ ٱلسَّمَاۤءُ مَوۡرࣰا\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 10,
      "text": "وَتَسِیرُ ٱلۡجِبَالُ سَیۡرࣰا\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 11,
      "text": "فَوَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 12,
      "text": "ٱلَّذِینَ هُمۡ فِی خَوۡضࣲ یَلۡعَبُونَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 13,
      "text": "یَوۡمَ یُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 14,
      "text": "هَـٰذِهِ ٱلنَّارُ ٱلَّتِی كُنتُم بِهَا تُكَذِّبُونَ\n",
      "juz": 27,
      "page": 523,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 15,
      "text": "أَفَسِحۡرٌ هَـٰذَاۤ أَمۡ أَنتُمۡ لَا تُبۡصِرُونَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 16,
      "text": "ٱصۡلَوۡهَا فَٱصۡبِرُوۤا۟ أَوۡ لَا تَصۡبِرُوا۟ سَوَاۤءٌ عَلَیۡكُمۡۖ إِنَّمَا تُجۡزَوۡنَ مَا كُنتُمۡ تَعۡمَلُونَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 17,
      "text": "إِنَّ ٱلۡمُتَّقِینَ فِی جَنَّـٰتࣲ وَنَعِیمࣲ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 18,
      "text": "فَـٰكِهِینَ بِمَاۤ ءَاتَىٰهُمۡ رَبُّهُمۡ وَوَقَىٰهُمۡ رَبُّهُمۡ عَذَابَ ٱلۡجَحِیمِ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 19,
      "text": "كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 20,
      "text": "مُتَّكِـِٔینَ عَلَىٰ سُرُرࣲ مَّصۡفُوفَةࣲۖ وَزَوَّجۡنَـٰهُم بِحُورٍ عِینࣲ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 21,
      "text": "وَٱلَّذِینَ ءَامَنُوا۟ وَٱتَّبَعَتۡهُمۡ ذُرِّیَّتُهُم بِإِیمَـٰنٍ أَلۡحَقۡنَا بِهِمۡ ذُرِّیَّتَهُمۡ وَمَاۤ أَلَتۡنَـٰهُم مِّنۡ عَمَلِهِم مِّن شَیۡءࣲۚ كُلُّ ٱمۡرِىِٕۭ بِمَا كَسَبَ رَهِینࣱ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 22,
      "text": "وَأَمۡدَدۡنَـٰهُم بِفَـٰكِهَةࣲ وَلَحۡمࣲ مِّمَّا یَشۡتَهُونَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 23,
      "text": "یَتَنَـٰزَعُونَ فِیهَا كَأۡسࣰا لَّا لَغۡوࣱ فِیهَا وَلَا تَأۡثِیمࣱ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 209,
      "ruku": 458
    },
    {
      "numberInSurah": 24,
      "text": "۞ وَیَطُوفُ عَلَیۡهِمۡ غِلۡمَانࣱ لَّهُمۡ كَأَنَّهُمۡ لُؤۡلُؤࣱ مَّكۡنُونࣱ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 458
    },
    {
      "numberInSurah": 25,
      "text": "وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ یَتَسَاۤءَلُونَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 458
    },
    {
      "numberInSurah": 26,
      "text": "قَالُوۤا۟ إِنَّا كُنَّا قَبۡلُ فِیۤ أَهۡلِنَا مُشۡفِقِینَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 458
    },
    {
      "numberInSurah": 27,
      "text": "فَمَنَّ ٱللَّهُ عَلَیۡنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 458
    },
    {
      "numberInSurah": 28,
      "text": "إِنَّا كُنَّا مِن قَبۡلُ نَدۡعُوهُۖ إِنَّهُۥ هُوَ ٱلۡبَرُّ ٱلرَّحِیمُ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 458
    },
    {
      "numberInSurah": 29,
      "text": "فَذَكِّرۡ فَمَاۤ أَنتَ بِنِعۡمَتِ رَبِّكَ بِكَاهِنࣲ وَلَا مَجۡنُونٍ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 30,
      "text": "أَمۡ یَقُولُونَ شَاعِرࣱ نَّتَرَبَّصُ بِهِۦ رَیۡبَ ٱلۡمَنُونِ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 31,
      "text": "قُلۡ تَرَبَّصُوا۟ فَإِنِّی مَعَكُم مِّنَ ٱلۡمُتَرَبِّصِینَ\n",
      "juz": 27,
      "page": 524,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 32,
      "text": "أَمۡ تَأۡمُرُهُمۡ أَحۡلَـٰمُهُم بِهَـٰذَاۤۚ أَمۡ هُمۡ قَوۡمࣱ طَاغُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 33,
      "text": "أَمۡ یَقُولُونَ تَقَوَّلَهُۥۚ بَل لَّا یُؤۡمِنُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 34,
      "text": "فَلۡیَأۡتُوا۟ بِحَدِیثࣲ مِّثۡلِهِۦۤ إِن كَانُوا۟ صَـٰدِقِینَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 35,
      "text": "أَمۡ خُلِقُوا۟ مِنۡ غَیۡرِ شَیۡءٍ أَمۡ هُمُ ٱلۡخَـٰلِقُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 36,
      "text": "أَمۡ خَلَقُوا۟ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضَۚ بَل لَّا یُوقِنُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 37,
      "text": "أَمۡ عِندَهُمۡ خَزَاۤىِٕنُ رَبِّكَ أَمۡ هُمُ ٱلۡمُصَۣیۡطِرُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 38,
      "text": "أَمۡ لَهُمۡ سُلَّمࣱ یَسۡتَمِعُونَ فِیهِۖ فَلۡیَأۡتِ مُسۡتَمِعُهُم بِسُلۡطَـٰنࣲ مُّبِینٍ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 39,
      "text": "أَمۡ لَهُ ٱلۡبَنَـٰتُ وَلَكُمُ ٱلۡبَنُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 40,
      "text": "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرࣰا فَهُم مِّن مَّغۡرَمࣲ مُّثۡقَلُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 41,
      "text": "أَمۡ عِندَهُمُ ٱلۡغَیۡبُ فَهُمۡ یَكۡتُبُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 42,
      "text": "أَمۡ یُرِیدُونَ كَیۡدࣰاۖ فَٱلَّذِینَ كَفَرُوا۟ هُمُ ٱلۡمَكِیدُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 43,
      "text": "أَمۡ لَهُمۡ إِلَـٰهٌ غَیۡرُ ٱللَّهِۚ سُبۡحَـٰنَ ٱللَّهِ عَمَّا یُشۡرِكُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 44,
      "text": "وَإِن یَرَوۡا۟ كِسۡفࣰا مِّنَ ٱلسَّمَاۤءِ سَاقِطࣰا یَقُولُوا۟ سَحَابࣱ مَّرۡكُومࣱ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 45,
      "text": "فَذَرۡهُمۡ حَتَّىٰ یُلَـٰقُوا۟ یَوۡمَهُمُ ٱلَّذِی فِیهِ یُصۡعَقُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 46,
      "text": "یَوۡمَ لَا یُغۡنِی عَنۡهُمۡ كَیۡدُهُمۡ شَیۡـࣰٔا وَلَا هُمۡ یُنصَرُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 47,
      "text": "وَإِنَّ لِلَّذِینَ ظَلَمُوا۟ عَذَابࣰا دُونَ ذَ ٰ⁠لِكَ وَلَـٰكِنَّ أَكۡثَرَهُمۡ لَا یَعۡلَمُونَ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 48,
      "text": "وَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ فَإِنَّكَ بِأَعۡیُنِنَاۖ وَسَبِّحۡ بِحَمۡدِ رَبِّكَ حِینَ تَقُومُ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    },
    {
      "numberInSurah": 49,
      "text": "وَمِنَ ٱلَّیۡلِ فَسَبِّحۡهُ وَإِدۡبَـٰرَ ٱلنُّجُومِ\n",
      "juz": 27,
      "page": 525,
      "hizbQuarter": 210,
      "ruku": 459
    }
  ]
}