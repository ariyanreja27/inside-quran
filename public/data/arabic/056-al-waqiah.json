{
  "surahNumber": 56,
  "surahName": "Al-Waqi'ah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 2,
      "text": "لَیۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 3,
      "text": "خَافِضَةࣱ رَّافِعَةٌ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 4,
      "text": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجࣰّا\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 5,
      "text": "وَبُسَّتِ ٱلۡجِبَالُ بَسࣰّا\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 6,
      "text": "فَكَانَتۡ هَبَاۤءࣰ مُّنۢبَثࣰّا\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 7,
      "text": "وَكُنتُمۡ أَزۡوَ ٰ⁠جࣰا ثَلَـٰثَةࣰ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 8,
      "text": "فَأَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ مَاۤ أَصۡحَـٰبُ ٱلۡمَیۡمَنَةِ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 9,
      "text": "وَأَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ مَاۤ أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 10,
      "text": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 11,
      "text": "أُو۟لَـٰۤىِٕكَ ٱلۡمُقَرَّبُونَ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 12,
      "text": "فِی جَنَّـٰتِ ٱلنَّعِیمِ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 13,
      "text": "ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِینَ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 14,
      "text": "وَقَلِیلࣱ مِّنَ ٱلۡـَٔاخِرِینَ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 15,
      "text": "عَلَىٰ سُرُرࣲ مَّوۡضُونَةࣲ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 16,
      "text": "مُّتَّكِـِٔینَ عَلَیۡهَا مُتَقَـٰبِلِینَ\n",
      "juz": 27,
      "page": 534,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 17,
      "text": "یَطُوفُ عَلَیۡهِمۡ وِلۡدَ ٰ⁠نࣱ مُّخَلَّدُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 18,
      "text": "بِأَكۡوَابࣲ وَأَبَارِیقَ وَكَأۡسࣲ مِّن مَّعِینࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 19,
      "text": "لَّا یُصَدَّعُونَ عَنۡهَا وَلَا یُنزِفُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 20,
      "text": "وَفَـٰكِهَةࣲ مِّمَّا یَتَخَیَّرُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 21,
      "text": "وَلَحۡمِ طَیۡرࣲ مِّمَّا یَشۡتَهُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 22,
      "text": "وَحُورٌ عِینࣱ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 23,
      "text": "كَأَمۡثَـٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 24,
      "text": "جَزَاۤءَۢ بِمَا كَانُوا۟ یَعۡمَلُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 25,
      "text": "لَا یَسۡمَعُونَ فِیهَا لَغۡوࣰا وَلَا تَأۡثِیمًا\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 26,
      "text": "إِلَّا قِیلࣰا سَلَـٰمࣰا سَلَـٰمࣰا\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 27,
      "text": "وَأَصۡحَـٰبُ ٱلۡیَمِینِ مَاۤ أَصۡحَـٰبُ ٱلۡیَمِینِ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 28,
      "text": "فِی سِدۡرࣲ مَّخۡضُودࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 29,
      "text": "وَطَلۡحࣲ مَّنضُودࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 30,
      "text": "وَظِلࣲّ مَّمۡدُودࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 31,
      "text": "وَمَاۤءࣲ مَّسۡكُوبࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 32,
      "text": "وَفَـٰكِهَةࣲ كَثِیرَةࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 33,
      "text": "لَّا مَقۡطُوعَةࣲ وَلَا مَمۡنُوعَةࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 34,
      "text": "وَفُرُشࣲ مَّرۡفُوعَةٍ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 35,
      "text": "إِنَّاۤ أَنشَأۡنَـٰهُنَّ إِنشَاۤءࣰ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 36,
      "text": "فَجَعَلۡنَـٰهُنَّ أَبۡكَارًا\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 37,
      "text": "عُرُبًا أَتۡرَابࣰا\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 38,
      "text": "لِّأَصۡحَـٰبِ ٱلۡیَمِینِ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 469
    },
    {
      "numberInSurah": 39,
      "text": "ثُلَّةࣱ مِّنَ ٱلۡأَوَّلِینَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 40,
      "text": "وَثُلَّةࣱ مِّنَ ٱلۡـَٔاخِرِینَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 41,
      "text": "وَأَصۡحَـٰبُ ٱلشِّمَالِ مَاۤ أَصۡحَـٰبُ ٱلشِّمَالِ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 42,
      "text": "فِی سَمُومࣲ وَحَمِیمࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 43,
      "text": "وَظِلࣲّ مِّن یَحۡمُومࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 44,
      "text": "لَّا بَارِدࣲ وَلَا كَرِیمٍ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 45,
      "text": "إِنَّهُمۡ كَانُوا۟ قَبۡلَ ذَ ٰ⁠لِكَ مُتۡرَفِینَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 46,
      "text": "وَكَانُوا۟ یُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِیمِ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 47,
      "text": "وَكَانُوا۟ یَقُولُونَ أَىِٕذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَـٰمًا أَءِنَّا لَمَبۡعُوثُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 48,
      "text": "أَوَءَابَاۤؤُنَا ٱلۡأَوَّلُونَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 49,
      "text": "قُلۡ إِنَّ ٱلۡأَوَّلِینَ وَٱلۡـَٔاخِرِینَ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 50,
      "text": "لَمَجۡمُوعُونَ إِلَىٰ مِیقَـٰتِ یَوۡمࣲ مَّعۡلُومࣲ\n",
      "juz": 27,
      "page": 535,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 51,
      "text": "ثُمَّ إِنَّكُمۡ أَیُّهَا ٱلضَّاۤلُّونَ ٱلۡمُكَذِّبُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 52,
      "text": "لَـَٔاكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 53,
      "text": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 54,
      "text": "فَشَـٰرِبُونَ عَلَیۡهِ مِنَ ٱلۡحَمِیمِ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 55,
      "text": "فَشَـٰرِبُونَ شُرۡبَ ٱلۡهِیمِ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 56,
      "text": "هَـٰذَا نُزُلُهُمۡ یَوۡمَ ٱلدِّینِ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 57,
      "text": "نَحۡنُ خَلَقۡنَـٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 58,
      "text": "أَفَرَءَیۡتُم مَّا تُمۡنُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 59,
      "text": "ءَأَنتُمۡ تَخۡلُقُونَهُۥۤ أَمۡ نَحۡنُ ٱلۡخَـٰلِقُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 60,
      "text": "نَحۡنُ قَدَّرۡنَا بَیۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِینَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 61,
      "text": "عَلَىٰۤ أَن نُّبَدِّلَ أَمۡثَـٰلَكُمۡ وَنُنشِئَكُمۡ فِی مَا لَا تَعۡلَمُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 62,
      "text": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 63,
      "text": "أَفَرَءَیۡتُم مَّا تَحۡرُثُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 64,
      "text": "ءَأَنتُمۡ تَزۡرَعُونَهُۥۤ أَمۡ نَحۡنُ ٱلزَّ ٰ⁠رِعُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 65,
      "text": "لَوۡ نَشَاۤءُ لَجَعَلۡنَـٰهُ حُطَـٰمࣰا فَظَلۡتُمۡ تَفَكَّهُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 66,
      "text": "إِنَّا لَمُغۡرَمُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 67,
      "text": "بَلۡ نَحۡنُ مَحۡرُومُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 68,
      "text": "أَفَرَءَیۡتُمُ ٱلۡمَاۤءَ ٱلَّذِی تَشۡرَبُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 69,
      "text": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 70,
      "text": "لَوۡ نَشَاۤءُ جَعَلۡنَـٰهُ أُجَاجࣰا فَلَوۡلَا تَشۡكُرُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 71,
      "text": "أَفَرَءَیۡتُمُ ٱلنَّارَ ٱلَّتِی تُورُونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 72,
      "text": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَاۤ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 73,
      "text": "نَحۡنُ جَعَلۡنَـٰهَا تَذۡكِرَةࣰ وَمَتَـٰعࣰا لِّلۡمُقۡوِینَ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 74,
      "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 214,
      "ruku": 470
    },
    {
      "numberInSurah": 75,
      "text": "۞ فَلَاۤ أُقۡسِمُ بِمَوَ ٰ⁠قِعِ ٱلنُّجُومِ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 76,
      "text": "وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِیمٌ\n",
      "juz": 27,
      "page": 536,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 77,
      "text": "إِنَّهُۥ لَقُرۡءَانࣱ كَرِیمࣱ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 78,
      "text": "فِی كِتَـٰبࣲ مَّكۡنُونࣲ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 79,
      "text": "لَّا یَمَسُّهُۥۤ إِلَّا ٱلۡمُطَهَّرُونَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 80,
      "text": "تَنزِیلࣱ مِّن رَّبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 81,
      "text": "أَفَبِهَـٰذَا ٱلۡحَدِیثِ أَنتُم مُّدۡهِنُونَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 82,
      "text": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 83,
      "text": "فَلَوۡلَاۤ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 84,
      "text": "وَأَنتُمۡ حِینَىِٕذࣲ تَنظُرُونَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 85,
      "text": "وَنَحۡنُ أَقۡرَبُ إِلَیۡهِ مِنكُمۡ وَلَـٰكِن لَّا تُبۡصِرُونَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 86,
      "text": "فَلَوۡلَاۤ إِن كُنتُمۡ غَیۡرَ مَدِینِینَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 87,
      "text": "تَرۡجِعُونَهَاۤ إِن كُنتُمۡ صَـٰدِقِینَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 88,
      "text": "فَأَمَّاۤ إِن كَانَ مِنَ ٱلۡمُقَرَّبِینَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 89,
      "text": "فَرَوۡحࣱ وَرَیۡحَانࣱ وَجَنَّتُ نَعِیمࣲ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 90,
      "text": "وَأَمَّاۤ إِن كَانَ مِنۡ أَصۡحَـٰبِ ٱلۡیَمِینِ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 91,
      "text": "فَسَلَـٰمࣱ لَّكَ مِنۡ أَصۡحَـٰبِ ٱلۡیَمِینِ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 92,
      "text": "وَأَمَّاۤ إِن كَانَ مِنَ ٱلۡمُكَذِّبِینَ ٱلضَّاۤلِّینَ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 93,
      "text": "فَنُزُلࣱ مِّنۡ حَمِیمࣲ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 94,
      "text": "وَتَصۡلِیَةُ جَحِیمٍ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 95,
      "text": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلۡیَقِینِ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    },
    {
      "numberInSurah": 96,
      "text": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِیمِ\n",
      "juz": 27,
      "page": 537,
      "hizbQuarter": 215,
      "ruku": 471
    }
  ]
}