{
  "surahNumber": 102,
  "surahName": "At-Takathur",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 2,
      "text": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 3,
      "text": "كَلَّا سَوۡفَ تَعۡلَمُونَ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 4,
      "text": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 5,
      "text": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡیَقِینِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 6,
      "text": "لَتَرَوُنَّ ٱلۡجَحِیمَ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 7,
      "text": "ثُمَّ لَتَرَوُنَّهَا عَیۡنَ ٱلۡیَقِینِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    },
    {
      "numberInSurah": 8,
      "text": "ثُمَّ لَتُسۡـَٔلُنَّ یَوۡمَىِٕذٍ عَنِ ٱلنَّعِیمِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 544
    }
  ]
}