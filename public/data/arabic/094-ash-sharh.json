{
  "surahNumber": 94,
  "surahName": "Ash-Sharh",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 2,
      "text": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 3,
      "text": "ٱلَّذِیۤ أَنقَضَ ظَهۡرَكَ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 4,
      "text": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 5,
      "text": "فَإِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرًا\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 6,
      "text": "إِنَّ مَعَ ٱلۡعُسۡرِ یُسۡرࣰا\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 7,
      "text": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    },
    {
      "numberInSurah": 8,
      "text": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 239,
      "ruku": 536
    }
  ]
}