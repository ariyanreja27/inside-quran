{
  "surahNumber": 96,
  "surahName": "Al-Alaq",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِی خَلَقَ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 2,
      "text": "خَلَقَ ٱلۡإِنسَـٰنَ مِنۡ عَلَقٍ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 3,
      "text": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 4,
      "text": "ٱلَّذِی عَلَّمَ بِٱلۡقَلَمِ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 5,
      "text": "عَلَّمَ ٱلۡإِنسَـٰنَ مَا لَمۡ یَعۡلَمۡ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 6,
      "text": "كَلَّاۤ إِنَّ ٱلۡإِنسَـٰنَ لَیَطۡغَىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 7,
      "text": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 9,
      "text": "أَرَءَیۡتَ ٱلَّذِی یَنۡهَىٰ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 10,
      "text": "عَبۡدًا إِذَا صَلَّىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 11,
      "text": "أَرَءَیۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 12,
      "text": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 13,
      "text": "أَرَءَیۡتَ إِن كَذَّبَ وَتَوَلَّىٰۤ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 14,
      "text": "أَلَمۡ یَعۡلَم بِأَنَّ ٱللَّهَ یَرَىٰ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 15,
      "text": "كَلَّا لَىِٕن لَّمۡ یَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِیَةِ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 16,
      "text": "نَاصِیَةࣲ كَـٰذِبَةٍ خَاطِئَةࣲ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 17,
      "text": "فَلۡیَدۡعُ نَادِیَهُۥ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 18,
      "text": "سَنَدۡعُ ٱلزَّبَانِیَةَ\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    },
    {
      "numberInSurah": 19,
      "text": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡ وَٱقۡتَرِب ۩\n",
      "juz": 30,
      "page": 597,
      "hizbQuarter": 239,
      "ruku": 538
    }
  ]
}