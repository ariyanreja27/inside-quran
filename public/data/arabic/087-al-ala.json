{
  "surahNumber": 87,
  "surahName": "Al-A'la",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 2,
      "text": "ٱلَّذِی خَلَقَ فَسَوَّىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلَّذِی قَدَّرَ فَهَدَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلَّذِیۤ أَخۡرَجَ ٱلۡمَرۡعَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 5,
      "text": "فَجَعَلَهُۥ غُثَاۤءً أَحۡوَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 6,
      "text": "سَنُقۡرِئُكَ فَلَا تَنسَىٰۤ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 7,
      "text": "إِلَّا مَا شَاۤءَ ٱللَّهُۚ إِنَّهُۥ یَعۡلَمُ ٱلۡجَهۡرَ وَمَا یَخۡفَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 8,
      "text": "وَنُیَسِّرُكَ لِلۡیُسۡرَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 9,
      "text": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 10,
      "text": "سَیَذَّكَّرُ مَن یَخۡشَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 11,
      "text": "وَیَتَجَنَّبُهَا ٱلۡأَشۡقَى\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 12,
      "text": "ٱلَّذِی یَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 13,
      "text": "ثُمَّ لَا یَمُوتُ فِیهَا وَلَا یَحۡیَىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 14,
      "text": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 15,
      "text": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ\n",
      "juz": 30,
      "page": 591,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 16,
      "text": "بَلۡ تُؤۡثِرُونَ ٱلۡحَیَوٰةَ ٱلدُّنۡیَا\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 17,
      "text": "وَٱلۡـَٔاخِرَةُ خَیۡرࣱ وَأَبۡقَىٰۤ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 18,
      "text": "إِنَّ هَـٰذَا لَفِی ٱلصُّحُفِ ٱلۡأُولَىٰ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 529
    },
    {
      "numberInSurah": 19,
      "text": "صُحُفِ إِبۡرَ ٰ⁠هِیمَ وَمُوسَىٰ\n",
      "juz": 30,
      "page": 592,
      "hizbQuarter": 237,
      "ruku": 529
    }
  ]
}