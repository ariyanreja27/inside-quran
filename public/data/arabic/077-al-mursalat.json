{
  "surahNumber": 77,
  "surahName": "Al-Mursalat",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلۡمُرۡسَلَـٰتِ عُرۡفࣰا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 2,
      "text": "فَٱلۡعَـٰصِفَـٰتِ عَصۡفࣰا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلنَّـٰشِرَ ٰ⁠تِ نَشۡرࣰا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 4,
      "text": "فَٱلۡفَـٰرِقَـٰتِ فَرۡقࣰا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 5,
      "text": "فَٱلۡمُلۡقِیَـٰتِ ذِكۡرًا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 6,
      "text": "عُذۡرًا أَوۡ نُذۡرًا\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 7,
      "text": "إِنَّمَا تُوعَدُونَ لَوَ ٰ⁠قِعࣱ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 8,
      "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 9,
      "text": "وَإِذَا ٱلسَّمَاۤءُ فُرِجَتۡ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 10,
      "text": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 11,
      "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 12,
      "text": "لِأَیِّ یَوۡمٍ أُجِّلَتۡ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 13,
      "text": "لِیَوۡمِ ٱلۡفَصۡلِ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 14,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا یَوۡمُ ٱلۡفَصۡلِ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 15,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 16,
      "text": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِینَ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 17,
      "text": "ثُمَّ نُتۡبِعُهُمُ ٱلۡـَٔاخِرِینَ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 18,
      "text": "كَذَ ٰ⁠لِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِینَ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 19,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 580,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 20,
      "text": "أَلَمۡ نَخۡلُقكُّم مِّن مَّاۤءࣲ مَّهِینࣲ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 21,
      "text": "فَجَعَلۡنَـٰهُ فِی قَرَارࣲ مَّكِینٍ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 22,
      "text": "إِلَىٰ قَدَرࣲ مَّعۡلُومࣲ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 23,
      "text": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَـٰدِرُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 24,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 25,
      "text": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 26,
      "text": "أَحۡیَاۤءࣰ وَأَمۡوَ ٰ⁠تࣰا\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 27,
      "text": "وَجَعَلۡنَا فِیهَا رَوَ ٰ⁠سِیَ شَـٰمِخَـٰتࣲ وَأَسۡقَیۡنَـٰكُم مَّاۤءࣰ فُرَاتࣰا\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 28,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 29,
      "text": "ٱنطَلِقُوۤا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 30,
      "text": "ٱنطَلِقُوۤا۟ إِلَىٰ ظِلࣲّ ذِی ثَلَـٰثِ شُعَبࣲ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 31,
      "text": "لَّا ظَلِیلࣲ وَلَا یُغۡنِی مِنَ ٱللَّهَبِ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 32,
      "text": "إِنَّهَا تَرۡمِی بِشَرَرࣲ كَٱلۡقَصۡرِ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 33,
      "text": "كَأَنَّهُۥ جِمَـٰلَتࣱ صُفۡرࣱ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 34,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 35,
      "text": "هَـٰذَا یَوۡمُ لَا یَنطِقُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 36,
      "text": "وَلَا یُؤۡذَنُ لَهُمۡ فَیَعۡتَذِرُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 37,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 38,
      "text": "هَـٰذَا یَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَـٰكُمۡ وَٱلۡأَوَّلِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 39,
      "text": "فَإِن كَانَ لَكُمۡ كَیۡدࣱ فَكِیدُونِ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 40,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 516
    },
    {
      "numberInSurah": 41,
      "text": "إِنَّ ٱلۡمُتَّقِینَ فِی ظِلَـٰلࣲ وَعُیُونࣲ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 42,
      "text": "وَفَوَ ٰ⁠كِهَ مِمَّا یَشۡتَهُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 43,
      "text": "كُلُوا۟ وَٱشۡرَبُوا۟ هَنِیۤـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 44,
      "text": "إِنَّا كَذَ ٰ⁠لِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 45,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 46,
      "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِیلًا إِنَّكُم مُّجۡرِمُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 47,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 48,
      "text": "وَإِذَا قِیلَ لَهُمُ ٱرۡكَعُوا۟ لَا یَرۡكَعُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 49,
      "text": "وَیۡلࣱ یَوۡمَىِٕذࣲ لِّلۡمُكَذِّبِینَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    },
    {
      "numberInSurah": 50,
      "text": "فَبِأَیِّ حَدِیثِۭ بَعۡدَهُۥ یُؤۡمِنُونَ\n",
      "juz": 29,
      "page": 581,
      "hizbQuarter": 232,
      "ruku": 517
    }
  ]
}