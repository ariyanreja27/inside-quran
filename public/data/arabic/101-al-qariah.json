{
  "surahNumber": 101,
  "surahName": "Al-Qari'ah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ ٱلۡقَارِعَةُ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 2,
      "text": "مَا ٱلۡقَارِعَةُ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 3,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 4,
      "text": "یَوۡمَ یَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 5,
      "text": "وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 6,
      "text": "فَأَمَّا مَن ثَقُلَتۡ مَوَ ٰ⁠زِینُهُۥ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 7,
      "text": "فَهُوَ فِی عِیشَةࣲ رَّاضِیَةࣲ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 8,
      "text": "وَأَمَّا مَنۡ خَفَّتۡ مَوَ ٰ⁠زِینُهُۥ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 9,
      "text": "فَأُمُّهُۥ هَاوِیَةࣱ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 10,
      "text": "وَمَاۤ أَدۡرَىٰكَ مَا هِیَهۡ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    },
    {
      "numberInSurah": 11,
      "text": "نَارٌ حَامِیَةُۢ\n",
      "juz": 30,
      "page": 600,
      "hizbQuarter": 240,
      "ruku": 543
    }
  ]
}