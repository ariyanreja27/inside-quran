{
  "surahNumber": 105,
  "surahName": "Al-Fil",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ أَلَمۡ تَرَ كَیۡفَ فَعَلَ رَبُّكَ بِأَصۡحَـٰبِ ٱلۡفِیلِ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 547
    },
    {
      "numberInSurah": 2,
      "text": "أَلَمۡ یَجۡعَلۡ كَیۡدَهُمۡ فِی تَضۡلِیلࣲ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 547
    },
    {
      "numberInSurah": 3,
      "text": "وَأَرۡسَلَ عَلَیۡهِمۡ طَیۡرًا أَبَابِیلَ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 547
    },
    {
      "numberInSurah": 4,
      "text": "تَرۡمِیهِم بِحِجَارَةࣲ مِّن سِجِّیلࣲ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 547
    },
    {
      "numberInSurah": 5,
      "text": "فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ\n",
      "juz": 30,
      "page": 601,
      "hizbQuarter": 240,
      "ruku": 547
    }
  ]
}