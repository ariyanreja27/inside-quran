{
  "surahNumber": 75,
  "surahName": "Al-Qiyamah",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ لَاۤ أُقۡسِمُ بِیَوۡمِ ٱلۡقِیَـٰمَةِ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 2,
      "text": "وَلَاۤ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 3,
      "text": "أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 4,
      "text": "بَلَىٰ قَـٰدِرِینَ عَلَىٰۤ أَن نُّسَوِّیَ بَنَانَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 5,
      "text": "بَلۡ یُرِیدُ ٱلۡإِنسَـٰنُ لِیَفۡجُرَ أَمَامَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 6,
      "text": "یَسۡـَٔلُ أَیَّانَ یَوۡمُ ٱلۡقِیَـٰمَةِ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 7,
      "text": "فَإِذَا بَرِقَ ٱلۡبَصَرُ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 8,
      "text": "وَخَسَفَ ٱلۡقَمَرُ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 9,
      "text": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 10,
      "text": "یَقُولُ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذٍ أَیۡنَ ٱلۡمَفَرُّ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 11,
      "text": "كَلَّا لَا وَزَرَ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 12,
      "text": "إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمُسۡتَقَرُّ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 13,
      "text": "یُنَبَّؤُا۟ ٱلۡإِنسَـٰنُ یَوۡمَىِٕذِۭ بِمَا قَدَّمَ وَأَخَّرَ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 14,
      "text": "بَلِ ٱلۡإِنسَـٰنُ عَلَىٰ نَفۡسِهِۦ بَصِیرَةࣱ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 15,
      "text": "وَلَوۡ أَلۡقَىٰ مَعَاذِیرَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 16,
      "text": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦۤ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 17,
      "text": "إِنَّ عَلَیۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 18,
      "text": "فَإِذَا قَرَأۡنَـٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 19,
      "text": "ثُمَّ إِنَّ عَلَیۡنَا بَیَانَهُۥ\n",
      "juz": 29,
      "page": 577,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 20,
      "text": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 21,
      "text": "وَتَذَرُونَ ٱلۡـَٔاخِرَةَ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 22,
      "text": "وُجُوهࣱ یَوۡمَىِٕذࣲ نَّاضِرَةٌ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 23,
      "text": "إِلَىٰ رَبِّهَا نَاظِرَةࣱ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 24,
      "text": "وَوُجُوهࣱ یَوۡمَىِٕذِۭ بَاسِرَةࣱ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 25,
      "text": "تَظُنُّ أَن یُفۡعَلَ بِهَا فَاقِرَةࣱ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 26,
      "text": "كَلَّاۤ إِذَا بَلَغَتِ ٱلتَّرَاقِیَ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 27,
      "text": "وَقِیلَ مَنۡۜ رَاقࣲ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 28,
      "text": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 29,
      "text": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 30,
      "text": "إِلَىٰ رَبِّكَ یَوۡمَىِٕذٍ ٱلۡمَسَاقُ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 512
    },
    {
      "numberInSurah": 31,
      "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 32,
      "text": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 33,
      "text": "ثُمَّ ذَهَبَ إِلَىٰۤ أَهۡلِهِۦ یَتَمَطَّىٰۤ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 34,
      "text": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 35,
      "text": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰۤ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 36,
      "text": "أَیَحۡسَبُ ٱلۡإِنسَـٰنُ أَن یُتۡرَكَ سُدًى\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 37,
      "text": "أَلَمۡ یَكُ نُطۡفَةࣰ مِّن مَّنِیࣲّ یُمۡنَىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 38,
      "text": "ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 39,
      "text": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَیۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰۤ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    },
    {
      "numberInSurah": 40,
      "text": "أَلَیۡسَ ذَ ٰ⁠لِكَ بِقَـٰدِرٍ عَلَىٰۤ أَن یُحۡـِۧیَ ٱلۡمَوۡتَىٰ\n",
      "juz": 29,
      "page": 578,
      "hizbQuarter": 231,
      "ruku": 513
    }
  ]
}