{
  "surahNumber": 84,
  "surahName": "Al-Inshiqaq",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ إِذَا ٱلسَّمَاۤءُ ٱنشَقَّتۡ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 2,
      "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 3,
      "text": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 4,
      "text": "وَأَلۡقَتۡ مَا فِیهَا وَتَخَلَّتۡ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 5,
      "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 6,
      "text": "یَـٰۤأَیُّهَا ٱلۡإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰا فَمُلَـٰقِیهِ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 7,
      "text": "فَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ بِیَمِینِهِۦ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 8,
      "text": "فَسَوۡفَ یُحَاسَبُ حِسَابࣰا یَسِیرࣰا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 9,
      "text": "وَیَنقَلِبُ إِلَىٰۤ أَهۡلِهِۦ مَسۡرُورࣰا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 10,
      "text": "وَأَمَّا مَنۡ أُوتِیَ كِتَـٰبَهُۥ وَرَاۤءَ ظَهۡرِهِۦ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 11,
      "text": "فَسَوۡفَ یَدۡعُوا۟ ثُبُورࣰا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 12,
      "text": "وَیَصۡلَىٰ سَعِیرًا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 13,
      "text": "إِنَّهُۥ كَانَ فِیۤ أَهۡلِهِۦ مَسۡرُورًا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 14,
      "text": "إِنَّهُۥ ظَنَّ أَن لَّن یَحُورَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 15,
      "text": "بَلَىٰۤۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِیرࣰا\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 16,
      "text": "فَلَاۤ أُقۡسِمُ بِٱلشَّفَقِ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 17,
      "text": "وَٱلَّیۡلِ وَمَا وَسَقَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 18,
      "text": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 19,
      "text": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 20,
      "text": "فَمَا لَهُمۡ لَا یُؤۡمِنُونَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 21,
      "text": "وَإِذَا قُرِئَ عَلَیۡهِمُ ٱلۡقُرۡءَانُ لَا یَسۡجُدُونَ ۩\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 22,
      "text": "بَلِ ٱلَّذِینَ كَفَرُوا۟ یُكَذِّبُونَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 23,
      "text": "وَٱللَّهُ أَعۡلَمُ بِمَا یُوعُونَ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 24,
      "text": "فَبَشِّرۡهُم بِعَذَابٍ أَلِیمٍ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    },
    {
      "numberInSurah": 25,
      "text": "إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمۡ أَجۡرٌ غَیۡرُ مَمۡنُونِۭ\n",
      "juz": 30,
      "page": 589,
      "hizbQuarter": 236,
      "ruku": 526
    }
  ]
}