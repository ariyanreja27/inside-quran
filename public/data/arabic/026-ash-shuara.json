    {
      "numberInSurah": 190,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَـَٔایَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 325
    },
    {
      "numberInSurah": 191,
      "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِیزُ ٱلرَّحِیمُ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 325
    },
    {
      "numberInSurah": 192,
      "text": "وَإِنَّهُۥ لَتَنزِیلُ رَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 193,
      "text": "نَزَلَ بِهِ ٱلرُّوحُ ٱلۡأَمِینُ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 194,
      "text": "عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 195,
      "text": "بِلِسَانٍ عَرَبِیࣲّ مُّبِینࣲ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 196,
      "text": "وَإِنَّهُۥ لَفِی زُبُرِ ٱلۡأَوَّلِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 197,
      "text": "أَوَلَمۡ یَكُن لَّهُمۡ ءَایَةً أَن یَعۡلَمَهُۥ عُلَمَـٰۤؤُا۟ بَنِیۤ إِسۡرَ ٰ⁠ۤءِیلَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 198,
      "text": "وَلَوۡ نَزَّلۡنَـٰهُ عَلَىٰ بَعۡضِ ٱلۡأَعۡجَمِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 199,
      "text": "فَقَرَأَهُۥ عَلَیۡهِم مَّا كَانُوا۟ بِهِۦ مُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 200,
      "text": "كَذَ ٰ⁠لِكَ سَلَكۡنَـٰهُ فِی قُلُوبِ ٱلۡمُجۡرِمِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 201,
      "text": "لَا یُؤۡمِنُونَ بِهِۦ حَتَّىٰ یَرَوُا۟ ٱلۡعَذَابَ ٱلۡأَلِیمَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 202,
      "text": "فَیَأۡتِیَهُم بَغۡتَةࣰ وَهُمۡ لَا یَشۡعُرُونَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 203,
      "text": "فَیَقُولُوا۟ هَلۡ نَحۡنُ مُنظَرُونَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 204,
      "text": "أَفَبِعَذَابِنَا یَسۡتَعۡجِلُونَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 205,
      "text": "أَفَرَءَیۡتَ إِن مَّتَّعۡنَـٰهُمۡ سِنِینَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 206,
      "text": "ثُمَّ جَاۤءَهُم مَّا كَانُوا۟ یُوعَدُونَ\n",
      "juz": 19,
      "page": 375,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 207,
      "text": "مَاۤ أَغۡنَىٰ عَنۡهُم مَّا كَانُوا۟ یُمَتَّعُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 208,
      "text": "وَمَاۤ أَهۡلَكۡنَا مِن قَرۡیَةٍ إِلَّا لَهَا مُنذِرُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 209,
      "text": "ذِكۡرَىٰ وَمَا كُنَّا ظَـٰلِمِینَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 210,
      "text": "وَمَا تَنَزَّلَتۡ بِهِ ٱلشَّیَـٰطِینُ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 211,
      "text": "وَمَا یَنۢبَغِی لَهُمۡ وَمَا یَسۡتَطِیعُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 212,
      "text": "إِنَّهُمۡ عَنِ ٱلسَّمۡعِ لَمَعۡزُولُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 213,
      "text": "فَلَا تَدۡعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلۡمُعَذَّبِینَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 214,
      "text": "وَأَنذِرۡ عَشِیرَتَكَ ٱلۡأَقۡرَبِینَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 215,
      "text": "وَٱخۡفِضۡ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 216,
      "text": "فَإِنۡ عَصَوۡكَ فَقُلۡ إِنِّی بَرِیۤءࣱ مِّمَّا تَعۡمَلُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 217,
      "text": "وَتَوَكَّلۡ عَلَى ٱلۡعَزِیزِ ٱلرَّحِیمِ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 218,
      "text": "ٱلَّذِی یَرَىٰكَ حِینَ تَقُومُ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 219,
      "text": "وَتَقَلُّبَكَ فِی ٱلسَّـٰجِدِینَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 220,
      "text": "إِنَّهُۥ هُوَ ٱلسَّمِیعُ ٱلۡعَلِیمُ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 221,
      "text": "هَلۡ أُنَبِّئُكُمۡ عَلَىٰ مَن تَنَزَّلُ ٱلشَّیَـٰطِینُ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 222,
      "text": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِیمࣲ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 223,
      "text": "یُلۡقُونَ ٱلسَّمۡعَ وَأَكۡثَرُهُمۡ كَـٰذِبُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 224,
      "text": "وَٱلشُّعَرَاۤءُ یَتَّبِعُهُمُ ٱلۡغَاوُۥنَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 225,
      "text": "أَلَمۡ تَرَ أَنَّهُمۡ فِی كُلِّ وَادࣲ یَهِیمُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 226,
      "text": "وَأَنَّهُمۡ یَقُولُونَ مَا لَا یَفۡعَلُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    },
    {
      "numberInSurah": 227,
      "text": "إِلَّا ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِیرࣰا وَٱنتَصَرُوا۟ مِنۢ بَعۡدِ مَا ظُلِمُوا۟ۗ وَسَیَعۡلَمُ ٱلَّذِینَ ظَلَمُوۤا۟ أَیَّ مُنقَلَبࣲ یَنقَلِبُونَ\n",
      "juz": 19,
      "page": 376,
      "hizbQuarter": 150,
      "ruku": 326
    }
  ]
}