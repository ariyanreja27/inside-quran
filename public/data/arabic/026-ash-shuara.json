{
  "surahNumber": 26,
  "surahName": "Ash-Shu'ara",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ طسۤمۤ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 2,
      "text": "تِلۡكَ ءَایَـٰتُ ٱلۡكِتَـٰبِ ٱلۡمُبِینِ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 3,
      "text": "لَعَلَّكَ بَـٰخِعࣱ نَّفۡسَكَ أَلَّا یَكُونُوا۟ مُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 4,
      "text": "إِن نَّشَأۡ نُنَزِّلۡ عَلَیۡهِم مِّنَ ٱلسَّمَاۤءِ ءَایَةࣰ فَظَلَّتۡ أَعۡنَـٰقُهُمۡ لَهَا خَـٰضِعِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 5,
      "text": "وَمَا یَأۡتِیهِم مِّن ذِكۡرࣲ مِّنَ ٱلرَّحۡمَـٰنِ مُحۡدَثٍ إِلَّا كَانُوا۟ عَنۡهُ مُعۡرِضِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 6,
      "text": "فَقَدۡ كَذَّبُوا۟ فَسَیَأۡتِیهِمۡ أَنۢبَـٰۤؤُا۟ مَا كَانُوا۟ بِهِۦ یَسۡتَهۡزِءُونَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 7,
      "text": "أَوَلَمۡ یَرَوۡا۟ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِیهَا مِن كُلِّ زَوۡجࣲ كَرِیمٍ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَـَٔایَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 9,
      "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِیزُ ٱلرَّحِیمُ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 316
    },
    {
      "numberInSurah": 10,
      "text": "وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰۤ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّـٰلِمِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 11,
      "text": "قَوۡمَ فِرۡعَوۡنَۚ أَلَا یَتَّقُونَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 12,
      "text": "قَالَ رَبِّ إِنِّیۤ أَخَافُ أَن یُكَذِّبُونِ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 13,
      "text": "وَیَضِیقُ صَدۡرِی وَلَا یَنطَلِقُ لِسَانِی فَأَرۡسِلۡ إِلَىٰ هَـٰرُونَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 14,
      "text": "وَلَهُمۡ عَلَیَّ ذَنۢبࣱ فَأَخَافُ أَن یَقۡتُلُونِ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 15,
      "text": "قَالَ كَلَّاۖ فَٱذۡهَبَا بِـَٔایَـٰتِنَاۤۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 16,
      "text": "فَأۡتِیَا فِرۡعَوۡنَ فَقُولَاۤ إِنَّا رَسُولُ رَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 17,
      "text": "أَنۡ أَرۡسِلۡ مَعَنَا بَنِیۤ إِسۡرَ ٰ⁠ۤءِیلَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 18,
      "text": "قَالَ أَلَمۡ نُرَبِّكَ فِینَا وَلِیدࣰا وَلَبِثۡتَ فِینَا مِنۡ عُمُرِكَ سِنِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 19,
      "text": "وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِی فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَـٰفِرِینَ\n",
      "juz": 19,
      "page": 367,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 20,
      "text": "قَالَ فَعَلۡتُهَاۤ إِذࣰا وَأَنَا۠ مِنَ ٱلضَّاۤلِّینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 21,
      "text": "فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِی رَبِّی حُكۡمࣰا وَجَعَلَنِی مِنَ ٱلۡمُرۡسَلِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 22,
      "text": "وَتِلۡكَ نِعۡمَةࣱ تَمُنُّهَا عَلَیَّ أَنۡ عَبَّدتَّ بَنِیۤ إِسۡرَ ٰ⁠ۤءِیلَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 23,
      "text": "قَالَ فِرۡعَوۡنُ وَمَا رَبُّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 24,
      "text": "قَالَ رَبُّ ٱلسَّمَـٰوَ ٰ⁠تِ وَٱلۡأَرۡضِ وَمَا بَیۡنَهُمَاۤۖ إِن كُنتُم مُّوقِنِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 25,
      "text": "قَالَ لِمَنۡ حَوۡلَهُۥۤ أَلَا تَسۡتَمِعُونَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 26,
      "text": "قَالَ رَبُّكُمۡ وَرَبُّ ءَابَاۤىِٕكُمُ ٱلۡأَوَّلِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 27,
      "text": "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِیۤ أُرۡسِلَ إِلَیۡكُمۡ لَمَجۡنُونࣱ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 28,
      "text": "قَالَ رَبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَمَا بَیۡنَهُمَاۤۖ إِن كُنتُمۡ تَعۡقِلُونَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 29,
      "text": "قَالَ لَىِٕنِ ٱتَّخَذۡتَ إِلَـٰهًا غَیۡرِی لَأَجۡعَلَنَّكَ مِنَ ٱلۡمَسۡجُونِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 30,
      "text": "قَالَ أَوَلَوۡ جِئۡتُكَ بِشَیۡءࣲ مُّبِینࣲ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 31,
      "text": "قَالَ فَأۡتِ بِهِۦۤ إِن كُنتَ مِنَ ٱلصَّـٰدِقِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 32,
      "text": "فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِیَ ثُعۡبَانࣱ مُّبِینࣱ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 33,
      "text": "وَنَزَعَ یَدَهُۥ فَإِذَا هِیَ بَیۡضَاۤءُ لِلنَّـٰظِرِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 317
    },
    {
      "numberInSurah": 34,
      "text": "قَالَ لِلۡمَلَإِ حَوۡلَهُۥۤ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِیمࣱ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 35,
      "text": "یُرِیدُ أَن یُخۡرِجَكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِۦ فَمَاذَا تَأۡمُرُونَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 36,
      "text": "قَالُوۤا۟ أَرۡجِهۡ وَأَخَاهُ وَٱبۡعَثۡ فِی ٱلۡمَدَاۤىِٕنِ حَـٰشِرِینَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 37,
      "text": "یَأۡتُوكَ بِكُلِّ سَحَّارٍ عَلِیمࣲ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 38,
      "text": "فَجُمِعَ ٱلسَّحَرَةُ لِمِیقَـٰتِ یَوۡمࣲ مَّعۡلُومࣲ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 39,
      "text": "وَقِیلَ لِلنَّاسِ هَلۡ أَنتُم مُّجۡتَمِعُونَ\n",
      "juz": 19,
      "page": 368,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 40,
      "text": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلۡغَـٰلِبِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 41,
      "text": "فَلَمَّا جَاۤءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرۡعَوۡنَ أَىِٕنَّ لَنَا لَأَجۡرًا إِن كُنَّا نَحۡنُ ٱلۡغَـٰلِبِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 42,
      "text": "قَالَ نَعَمۡ وَإِنَّكُمۡ إِذࣰا لَّمِنَ ٱلۡمُقَرَّبِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 43,
      "text": "قَالَ لَهُم مُّوسَىٰۤ أَلۡقُوا۟ مَاۤ أَنتُم مُّلۡقُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 44,
      "text": "فَأَلۡقَوۡا۟ حِبَالَهُمۡ وَعِصِیَّهُمۡ وَقَالُوا۟ بِعِزَّةِ فِرۡعَوۡنَ إِنَّا لَنَحۡنُ ٱلۡغَـٰلِبُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 45,
      "text": "فَأَلۡقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِیَ تَلۡقَفُ مَا یَأۡفِكُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 46,
      "text": "فَأُلۡقِیَ ٱلسَّحَرَةُ سَـٰجِدِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 47,
      "text": "قَالُوۤا۟ ءَامَنَّا بِرَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 48,
      "text": "رَبِّ مُوسَىٰ وَهَـٰرُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 49,
      "text": "قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِیرُكُمُ ٱلَّذِی عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَیۡدِیَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَـٰفࣲ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 50,
      "text": "قَالُوا۟ لَا ضَیۡرَۖ إِنَّاۤ إِلَىٰ رَبِّنَا مُنقَلِبُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 51,
      "text": "إِنَّا نَطۡمَعُ أَن یَغۡفِرَ لَنَا رَبُّنَا خَطَـٰیَـٰنَاۤ أَن كُنَّاۤ أَوَّلَ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 147,
      "ruku": 318
    },
    {
      "numberInSurah": 52,
      "text": "۞ وَأَوۡحَیۡنَاۤ إِلَىٰ مُوسَىٰۤ أَنۡ أَسۡرِ بِعِبَادِیۤ إِنَّكُم مُّتَّبَعُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 318
    },
    {
      "numberInSurah": 53,
      "text": "فَأَرۡسَلَ فِرۡعَوۡنُ فِی ٱلۡمَدَاۤىِٕنِ حَـٰشِرِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 54,
      "text": "إِنَّ هَـٰۤؤُلَاۤءِ لَشِرۡذِمَةࣱ قَلِیلُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 55,
      "text": "وَإِنَّهُمۡ لَنَا لَغَاۤىِٕظُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 56,
      "text": "وَإِنَّا لَجَمِیعٌ حَـٰذِرُونَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 57,
      "text": "فَأَخۡرَجۡنَـٰهُم مِّن جَنَّـٰتࣲ وَعُیُونࣲ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 58,
      "text": "وَكُنُوزࣲ وَمَقَامࣲ كَرِیمࣲ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 59,
      "text": "كَذَ ٰ⁠لِكَۖ وَأَوۡرَثۡنَـٰهَا بَنِیۤ إِسۡرَ ٰ⁠ۤءِیلَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 60,
      "text": "فَأَتۡبَعُوهُم مُّشۡرِقِینَ\n",
      "juz": 19,
      "page": 369,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 61,
      "text": "فَلَمَّا تَرَ ٰ⁠ۤءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَـٰبُ مُوسَىٰۤ إِنَّا لَمُدۡرَكُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 62,
      "text": "قَالَ كَلَّاۤۖ إِنَّ مَعِیَ رَبِّی سَیَهۡدِینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 63,
      "text": "فَأَوۡحَیۡنَاۤ إِلَىٰ مُوسَىٰۤ أَنِ ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقࣲ كَٱلطَّوۡدِ ٱلۡعَظِیمِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 64,
      "text": "وَأَزۡلَفۡنَا ثَمَّ ٱلۡـَٔاخَرِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 65,
      "text": "وَأَنجَیۡنَا مُوسَىٰ وَمَن مَّعَهُۥۤ أَجۡمَعِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 66,
      "text": "ثُمَّ أَغۡرَقۡنَا ٱلۡـَٔاخَرِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 67,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَـَٔایَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 68,
      "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِیزُ ٱلرَّحِیمُ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 69,
      "text": "وَٱتۡلُ عَلَیۡهِمۡ نَبَأَ إِبۡرَ ٰ⁠هِیمَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 319
    },
    {
      "numberInSurah": 70,
      "text": "إِذۡ قَالَ لِأَبِیهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 71,
      "text": "قَالُوا۟ نَعۡبُدُ أَصۡنَامࣰا فَنَظَلُّ لَهَا عَـٰكِفِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 72,
      "text": "قَالَ هَلۡ یَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 73,
      "text": "أَوۡ یَنفَعُونَكُمۡ أَوۡ یَضُرُّونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 74,
      "text": "قَالُوا۟ بَلۡ وَجَدۡنَاۤ ءَابَاۤءَنَا كَذَ ٰ⁠لِكَ یَفۡعَلُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 75,
      "text": "قَالَ أَفَرَءَیۡتُم مَّا كُنتُمۡ تَعۡبُدُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 76,
      "text": "أَنتُمۡ وَءَابَاۤؤُكُمُ ٱلۡأَقۡدَمُونَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 77,
      "text": "فَإِنَّهُمۡ عَدُوࣱّ لِّیۤ إِلَّا رَبَّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 78,
      "text": "ٱلَّذِی خَلَقَنِی فَهُوَ یَهۡدِینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 79,
      "text": "وَٱلَّذِی هُوَ یُطۡعِمُنِی وَیَسۡقِینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 80,
      "text": "وَإِذَا مَرِضۡتُ فَهُوَ یَشۡفِینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 81,
      "text": "وَٱلَّذِی یُمِیتُنِی ثُمَّ یُحۡیِینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 82,
      "text": "وَٱلَّذِیۤ أَطۡمَعُ أَن یَغۡفِرَ لِی خَطِیۤـَٔتِی یَوۡمَ ٱلدِّینِ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 83,
      "text": "رَبِّ هَبۡ لِی حُكۡمࣰا وَأَلۡحِقۡنِی بِٱلصَّـٰلِحِینَ\n",
      "juz": 19,
      "page": 370,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 84,
      "text": "وَٱجۡعَل لِّی لِسَانَ صِدۡقࣲ فِی ٱلۡـَٔاخِرِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 85,
      "text": "وَٱجۡعَلۡنِی مِن وَرَثَةِ جَنَّةِ ٱلنَّعِیمِ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 86,
      "text": "وَٱغۡفِرۡ لِأَبِیۤ إِنَّهُۥ كَانَ مِنَ ٱلضَّاۤلِّینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 87,
      "text": "وَلَا تُخۡزِنِی یَوۡمَ یُبۡعَثُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 88,
      "text": "یَوۡمَ لَا یَنفَعُ مَالࣱ وَلَا بَنُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 89,
      "text": "إِلَّا مَنۡ أَتَى ٱللَّهَ بِقَلۡبࣲ سَلِیمࣲ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 90,
      "text": "وَأُزۡلِفَتِ ٱلۡجَنَّةُ لِلۡمُتَّقِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 91,
      "text": "وَبُرِّزَتِ ٱلۡجَحِیمُ لِلۡغَاوِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 92,
      "text": "وَقِیلَ لَهُمۡ أَیۡنَ مَا كُنتُمۡ تَعۡبُدُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 93,
      "text": "مِن دُونِ ٱللَّهِ هَلۡ یَنصُرُونَكُمۡ أَوۡ یَنتَصِرُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 94,
      "text": "فَكُبۡكِبُوا۟ فِیهَا هُمۡ وَٱلۡغَاوُۥنَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 95,
      "text": "وَجُنُودُ إِبۡلِیسَ أَجۡمَعُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 96,
      "text": "قَالُوا۟ وَهُمۡ فِیهَا یَخۡتَصِمُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 97,
      "text": "تَٱللَّهِ إِن كُنَّا لَفِی ضَلَـٰلࣲ مُّبِینٍ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 98,
      "text": "إِذۡ نُسَوِّیكُم بِرَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 99,
      "text": "وَمَاۤ أَضَلَّنَاۤ إِلَّا ٱلۡمُجۡرِمُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 100,
      "text": "فَمَا لَنَا مِن شَـٰفِعِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 101,
      "text": "وَلَا صَدِیقٍ حَمِیمࣲ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 102,
      "text": "فَلَوۡ أَنَّ لَنَا كَرَّةࣰ فَنَكُونَ مِنَ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 103,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَـَٔایَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 104,
      "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِیزُ ٱلرَّحِیمُ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 320
    },
    {
      "numberInSurah": 105,
      "text": "كَذَّبَتۡ قَوۡمُ نُوحٍ ٱلۡمُرۡسَلِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 106,
      "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ نُوحٌ أَلَا تَتَّقُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 107,
      "text": "إِنِّی لَكُمۡ رَسُولٌ أَمِینࣱ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 108,
      "text": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِیعُونِ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 109,
      "text": "وَمَاۤ أَسۡـَٔلُكُمۡ عَلَیۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِیَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَـٰلَمِینَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 110,
      "text": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِیعُونِ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 148,
      "ruku": 321
    },
    {
      "numberInSurah": 111,
      "text": "۞ قَالُوۤا۟ أَنُؤۡمِنُ لَكَ وَٱتَّبَعَكَ ٱلۡأَرۡذَلُونَ\n",
      "juz": 19,
      "page": 371,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 112,
      "text": "قَالَ وَمَا عِلۡمِی بِمَا كَانُوا۟ یَعۡمَلُونَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 113,
      "text": "إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّیۖ لَوۡ تَشۡعُرُونَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 114,
      "text": "وَمَاۤ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 115,
      "text": "إِنۡ أَنَا۠ إِلَّا نَذِیرࣱ مُّبِینࣱ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 116,
      "text": "قَالُوا۟ لَىِٕن لَّمۡ تَنتَهِ یَـٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 117,
      "text": "قَالَ رَبِّ إِنَّ قَوۡمِی كَذَّبُونِ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 118,
      "text": "فَٱفۡتَحۡ بَیۡنِی وَبَیۡنَهُمۡ فَتۡحࣰا وَنَجِّنِی وَمَن مَّعِیَ مِنَ ٱلۡمُؤۡمِنِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 119,
      "text": "فَأَنجَیۡنَـٰهُ وَمَن مَّعَهُۥ فِی ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 120,
      "text": "ثُمَّ أَغۡرَقۡنَا بَعۡدُ ٱلۡبَاقِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 121,
      "text": "إِنَّ فِی ذَ ٰ⁠لِكَ لَـَٔایَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 122,
      "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِیزُ ٱلرَّحِیمُ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 321
    },
    {
      "numberInSurah": 123,
      "text": "كَذَّبَتۡ عَادٌ ٱلۡمُرۡسَلِینَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 322
    },
    {
      "numberInSurah": 124,
      "text": "إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 322
    },
    {
      "numberInSurah": 125,
      "text": "إِنِّی لَكُمۡ رَسُولٌ أَمِینࣱ\n",
      "juz": 19,
      "page": 372,
      "hizbQuarter": 149,
      "ruku": 322
    },
    {
      "numberInSurah": 126,
      "text": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِیعُونِ\n",
      "juz": 19,
