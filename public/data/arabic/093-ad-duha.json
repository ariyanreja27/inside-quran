{
  "surahNumber": 93,
  "surahName": "Ad-Duha",
  "verses": [
    {
      "numberInSurah": 1,
      "text": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَـٰنِ ٱلرَّحِیمِ وَٱلضُّحَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلَّیۡلِ إِذَا سَجَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 3,
      "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 4,
      "text": "وَلَلۡـَٔاخِرَةُ خَیۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 5,
      "text": "وَلَسَوۡفَ یُعۡطِیكَ رَبُّكَ فَتَرۡضَىٰۤ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 6,
      "text": "أَلَمۡ یَجِدۡكَ یَتِیمࣰا فَـَٔاوَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 7,
      "text": "وَوَجَدَكَ ضَاۤلࣰّا فَهَدَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 8,
      "text": "وَوَجَدَكَ عَاۤىِٕلࣰا فَأَغۡنَىٰ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 9,
      "text": "فَأَمَّا ٱلۡیَتِیمَ فَلَا تَقۡهَرۡ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 10,
      "text": "وَأَمَّا ٱلسَّاۤىِٕلَ فَلَا تَنۡهَرۡ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    },
    {
      "numberInSurah": 11,
      "text": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ\n",
      "juz": 30,
      "page": 596,
      "hizbQuarter": 238,
      "ruku": 535
    }
  ]
}